# ============================================================
# Ontology: Archaeological Object Module — Pattern: Pattern 1 Event Driven
# Model: deepseek-v4-pro | Block-aware generation
# Strategy: ontogenia | Step: 49/50 | Block: 8
# CQ: CQ-OBJ-49 | Temperature: 0.5
# ============================================================

@prefix arqo: <http://www.ontologyARQ.org/archaeological-object/> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix crmarchaeo: <http://www.cidoc-crm.org/crmarchaeo/> .
@prefix crmsci: <http://www.cidoc-crm.org/crmsci/> .
@prefix crminf: <http://www.cidoc-crm.org/crminf/> .
@prefix crmhs: <http://www.cidoc-crm.org/crmhs/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

# ======================= CLASSES ===========================

# ─── Expert Taxonomy ───
arqo:ArchaeologicalObject a owl:Class ;
    rdfs:subClassOf crm:E19_Physical_Object ;
    rdfs:label "ArchaeologicalObject"@en ;
    rdfs:comment "Physical object recovered during archaeological investigation"@en .

arqo:NaturalObject a owl:Class ;
    rdfs:subClassOf arqo:ArchaeologicalObject ;
    rdfs:label "NaturalObject"@en ;
    rdfs:comment "Object of natural origin found in archaeological context (ecofact)"@en .

arqo:AbioticObject a owl:Class ;
    rdfs:subClassOf arqo:NaturalObject ;
    rdfs:label "AbioticObject"@en ;
    rdfs:comment "Non-living natural object (stone, mineral, sediment)"@en .

arqo:BioticObject a owl:Class ;
    rdfs:subClassOf arqo:NaturalObject ;
    rdfs:label "BioticObject"@en ;
    rdfs:comment "Living or once-living natural object (bone, shell, wood, plant remains)"@en .

arqo:HumanMadeObject a owl:Class ;
    rdfs:subClassOf arqo:ArchaeologicalObject ;
    owl:equivalentClass crm:E22_Human-Made_Object ;
    rdfs:label "HumanMadeObject"@en ;
    rdfs:comment "Object created or modified by human action"@en .

arqo:Artefact a owl:Class ;
    rdfs:subClassOf arqo:HumanMadeObject ;
    rdfs:label "Artefact"@en ;
    rdfs:comment "Portable human-made object with functional purpose"@en .

arqo:Structure a owl:Class ;
    rdfs:subClassOf arqo:HumanMadeObject ;
    rdfs:label "Structure"@en ;
    rdfs:comment "Non-portable human-made construction"@en .

arqo:ArtisticExpression a owl:Class ;
    rdfs:subClassOf arqo:HumanMadeObject ;
    rdfs:label "ArtisticExpression"@en ;
    rdfs:comment "Human-made object with aesthetic or symbolic function"@en .

# Blocks 7-8 — Object Relations & Disputed Classification
# From DeepSeek analysis: Competing interpretations via CRMinf

arqo:hasCompetingInterpretation a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range crminf:I4_Proposition_Set ;
    rdfs:label "hasCompetingInterpretation"@en .

arqo:hasRepatriationDate a owl:DatatypeProperty ;
    rdfs:domain arqo:RepatriationEvent ;
    rdfs:range xsd:date ;
    rdfs:label "hasRepatriationDate"@en .

# Block 1 — Taxonomy & Classification
# From DeepSeek analysis: ObjectForm, ChaineOperatoire
arqo:ObjectForm a owl:Class ;
    rdfs:subClassOf crm:E54_Dimension ;
    rdfs:label "ObjectForm"@en ;
    rdfs:comment "Morphological configuration including dimensions, shape, surface characteristics"@en .

arqo:ChaineOperatoire a owl:Class ;
    rdfs:subClassOf crm:E29_Design_or_Procedure ;
    rdfs:label "ChaineOperatoire"@en ;
    rdfs:comment "Operational sequence of manufacturing steps from raw material to completion"@en .

arqo:hasForm a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:ObjectForm ;
    rdfs:label "hasForm"@en .

arqo:followsChaineOperatoire a owl:ObjectProperty ;
    rdfs:domain arqo:HumanMadeObject ;
    rdfs:range arqo:ChaineOperatoire ;
    rdfs:label "followsChaineOperatoire"@en .

arqo:hasLocalIdentifier a owl:DatatypeProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range xsd:string ;
    rdfs:label "hasLocalIdentifier"@en .

# Block 2 — Materiality & Provenance
# From DeepSeek analysis: MaterialAssignment, RawMaterialSource, ProvenanceRegion, ProvenanceChain
arqo:RawMaterialSource a owl:Class ;
    rdfs:subClassOf crm:E53_Place ;
    rdfs:label "RawMaterialSource"@en ;
    rdfs:comment "Geological or geographic source from which raw materials were extracted"@en .

arqo:ProvenanceRegion a owl:Class ;
    rdfs:subClassOf crm:E53_Place ;
    rdfs:label "ProvenanceRegion"@en ;
    rdfs:comment "Geographic origin region of an object or its constituent materials"@en .

arqo:MaterialAssignment a owl:Class ;
    rdfs:subClassOf crm:E17_Type_Assignment ;
    rdfs:label "MaterialAssignment"@en ;
    rdfs:comment "Researcher assertion about material composition of an archaeological object"@en .

arqo:hasMaterial a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range crm:E57_Material ;
    rdfs:label "hasMaterial"@en .

arqo:derivesFromSource a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:RawMaterialSource ;
    rdfs:label "derivesFromSource"@en .

arqo:hasProvenance a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:ProvenanceRegion ;
    rdfs:label "hasProvenance"@en .

arqo:hasMaterialAssignment a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:MaterialAssignment ;
    rdfs:label "hasMaterialAssignment"@en .

arqo:hasManufacturingTechnique a owl:DatatypeProperty ;
    rdfs:domain arqo:HumanMadeObject ;
    rdfs:range xsd:string ;
    rdfs:label "hasManufacturingTechnique"@en .

# Block 3 — Object Lifecycle (core event pattern)
# From DeepSeek analysis: ManufacturingEvent, UseEvent, ReuseEvent, RepairEvent,
# DepositionEvent, RecoveryEvent, CirculationEvent, ObjectBiography, ObjectLifecycle

arqo:ManufacturingEvent a owl:Class ;
    rdfs:subClassOf crm:E12_Production ;
    rdfs:label "ManufacturingEvent"@en ;
    rdfs:comment "Event of object production through specific technological procedures"@en .

arqo:UseEvent a owl:Class ;
    rdfs:subClassOf crm:E7_Activity ;
    rdfs:label "UseEvent"@en ;
    rdfs:comment "Event of object utilization in its original or assigned functional role"@en .

arqo:ReuseEvent a owl:Class ;
    rdfs:subClassOf crm:E7_Activity ;
    rdfs:label "ReuseEvent"@en ;
    rdfs:comment "Secondary use of an object for a function different from its original intended use"@en .

arqo:RepairEvent a owl:Class ;
    rdfs:subClassOf crm:E81_Transformation ;
    rdfs:label "RepairEvent"@en ;
    rdfs:comment "Physical modification of an object to restore function or extend use-life"@en .

arqo:DepositionEvent a owl:Class ;
    rdfs:subClassOf crmarchaeo:A4_Stratigraphic_Genesis ;
    rdfs:label "DepositionEvent"@en ;
    rdfs:comment "Event of an object entering the archaeological record through intentional or accidental discard"@en .

arqo:RecoveryEvent a owl:Class ;
    rdfs:subClassOf crmarchaeo:A1_Excavation_Process_Unit ;
    rdfs:label "RecoveryEvent"@en ;
    rdfs:comment "Event of object being excavated or recovered from depositional context"@en .

arqo:CirculationEvent a owl:Class ;
    rdfs:subClassOf crm:E9_Move ;
    rdfs:label "CirculationEvent"@en ;
    rdfs:comment "Event of an object moving between geographic locations or cultural zones during use-life"@en .

arqo:RepatriationEvent a owl:Class ;
    rdfs:subClassOf crm:E9_Move ;
    rdfs:label "RepatriationEvent"@en ;
    rdfs:comment "Event of returning an archaeological object to its country or community of origin"@en .

arqo:ObjectBiography a owl:Class ;
    rdfs:subClassOf crm:E5_Event ;
    rdfs:label "ObjectBiography"@en ;
    rdfs:comment "Narrative sequence of events constituting the lifecycle of an archaeological object"@en .

arqo:ObjectLifecycle a owl:Class ;
    rdfs:subClassOf crm:E5_Event ;
    rdfs:label "ObjectLifecycle"@en ;
    rdfs:comment "Physical sequence of states and transitions from manufacture through deposition"@en .

arqo:ProvenanceChain a owl:Class ;
    rdfs:subClassOf crm:E5_Event ;
    rdfs:label "ProvenanceChain"@en ;
    rdfs:comment "Traceable path from raw material source to findspot, reconstructed forensically"@en .

arqo:wasProducedBy a owl:ObjectProperty ;
    rdfs:domain arqo:HumanMadeObject ;
    rdfs:range arqo:ManufacturingEvent ;
    rdfs:label "wasProducedBy"@en .

arqo:wasUsedIn a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:UseEvent ;
    rdfs:label "wasUsedIn"@en .

arqo:wasReusedIn a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:ReuseEvent ;
    rdfs:label "wasReusedIn"@en .

arqo:wasRepairedIn a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:RepairEvent ;
    rdfs:label "wasRepairedIn"@en .

arqo:wasDepositedIn a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:DepositionEvent ;
    rdfs:label "wasDepositedIn"@en .

arqo:wasRecoveredIn a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:RecoveryEvent ;
    rdfs:label "wasRecoveredIn"@en .

arqo:circulatedThrough a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:CirculationEvent ;
    rdfs:label "circulatedThrough"@en .

arqo:wasRepatriatedIn a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:RepatriationEvent ;
    rdfs:label "wasRepatriatedIn"@en .

arqo:hasBiography a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:ObjectBiography ;
    rdfs:label "hasBiography"@en .

arqo:hasLifecycle a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:ObjectLifecycle ;
    rdfs:label "hasLifecycle"@en .

arqo:sharesProvenanceChain a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:ArchaeologicalObject ;
    rdfs:label "sharesProvenanceChain"@en .

arqo:associatedWithActor a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range crm:E39_Actor ;
    rdfs:label "associatedWithActor"@en .

arqo:hasManufacturingDateStart a owl:DatatypeProperty ;
    rdfs:domain arqo:ManufacturingEvent ;
    rdfs:range xsd:dateTime ;
    rdfs:label "hasManufacturingDateStart"@en .

arqo:hasManufacturingDateEnd a owl:DatatypeProperty ;
    rdfs:domain arqo:ManufacturingEvent ;
    rdfs:range xsd:dateTime ;
    rdfs:label "hasManufacturingDateEnd"@en .

arqo:hasUseDateStart a owl:DatatypeProperty ;
    rdfs:domain arqo:UseEvent ;
    rdfs:range xsd:dateTime ;
    rdfs:label "hasUseDateStart"@en .

arqo:hasUseDateEnd a owl:DatatypeProperty ;
    rdfs:domain arqo:UseEvent ;
    rdfs:range xsd:dateTime ;
    rdfs:label "hasUseDateEnd"@en .

arqo:hasDepositionDate a owl:DatatypeProperty ;
    rdfs:domain arqo:DepositionEvent ;
    rdfs:range xsd:dateTime ;
    rdfs:label "hasDepositionDate"@en .

arqo:hasTerminusPostQuem a owl:DatatypeProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range xsd:dateTime ;
    rdfs:label "hasTerminusPostQuem"@en .

arqo:hasTerminusAnteQuem a owl:DatatypeProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range xsd:dateTime ;
    rdfs:label "hasTerminusAnteQuem"@en .

arqo:hasLifespanDuration a owl:DatatypeProperty ;
    rdfs:domain arqo:ObjectLifecycle ;
    rdfs:range xsd:duration ;
    rdfs:label "hasLifespanDuration"@en .

# Block 4 — Typology, Function & Meaning
# From DeepSeek analysis: TypologicalAssignment, ChronologicalAssignment, Pastness, Patina, ObjectAgency

arqo:TypologicalAssignment a owl:Class ;
    rdfs:subClassOf crm:E17_Type_Assignment ;
    rdfs:label "TypologicalAssignment"@en ;
    rdfs:comment "Researcher assignment of an object to a typological category based on diagnostic criteria"@en .

arqo:ChronologicalAssignment a owl:Class ;
    rdfs:subClassOf crm:E17_Type_Assignment ;
    rdfs:label "ChronologicalAssignment"@en ;
    rdfs:comment "Researcher assignment of an archaeological object or event to a temporal period"@en .

arqo:Pastness a owl:Class ;
    rdfs:subClassOf crminf:I4_Proposition_Set ;
    rdfs:label "Pastness"@en ;
    rdfs:comment "Perceived quality of being from the past — culturally constructed aesthetic and cognitive experience"@en .

arqo:ObjectAgency a owl:Class ;
    rdfs:label "ObjectAgency"@en ;
    rdfs:comment "Capacity of an object to affect human behavior, actions, or perceptions independently of human intention"@en .

arqo:hasTypologicalAssignment a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:TypologicalAssignment ;
    rdfs:label "hasTypologicalAssignment"@en .

arqo:hasChronologicalAssignment a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:ChronologicalAssignment ;
    rdfs:label "hasChronologicalAssignment"@en .

arqo:exhibitsPastness a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:Pastness ;
    rdfs:label "exhibitsPastness"@en .

arqo:exertsAgency a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:ObjectAgency ;
    rdfs:label "exertsAgency"@en .

arqo:hasCulturalSignificance a owl:DatatypeProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range xsd:string ;
    rdfs:label "hasCulturalSignificance"@en .

# Block 5 — Physical States & Transformation
# From DeepSeek analysis: ObjectTransformation, Fragmentation, Patina

arqo:ObjectTransformation a owl:Class ;
    rdfs:subClassOf crm:E81_Transformation ;
    rdfs:label "ObjectTransformation"@en ;
    rdfs:comment "Deliberate or accidental change to an object's physical form, function, or meaning"@en .

arqo:Fragmentation a owl:Class ;
    rdfs:subClassOf crm:E3_Condition_State ;
    rdfs:label "Fragmentation"@en ;
    rdfs:comment "Physical state where an object exists as multiple disconnected fragments"@en .

arqo:Patina a owl:Class ;
    rdfs:subClassOf crm:E3_Condition_State ;
    rdfs:label "Patina"@en ;
    rdfs:comment "Physical surface alteration connoting age, valued culturally as authenticity evidence"@en .

arqo:underwentTransformation a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:ObjectTransformation ;
    rdfs:label "underwentTransformation"@en .

arqo:isFragmentedInto a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:ArchaeologicalObject ;
    rdfs:label "isFragmentedInto"@en .

arqo:hasPatina a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:Patina ;
    rdfs:label "hasPatina"@en .

arqo:hasConservationState a owl:DatatypeProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range xsd:string ;
    rdfs:label "hasConservationState"@en .

arqo:hasPreservationRating a owl:DatatypeProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range xsd:decimal ;
    rdfs:label "hasPreservationRating"@en .

# Block 6 — Analysis, Conservation & Custody
# From DeepSeek analysis: AnalyticalEncounter, ConservationTreatment, ConservationDecision

arqo:AnalyticalEncounter a owl:Class ;
    rdfs:subClassOf crmsci:S19_Encounter ;
    rdfs:label "AnalyticalEncounter"@en ;
    rdfs:comment "Scientific analysis event where physical or chemical properties of an object are measured"@en .

arqo:ConservationTreatment a owl:Class ;
    rdfs:subClassOf crm:E7_Activity ;
    rdfs:label "ConservationTreatment"@en ;
    rdfs:comment "Post-recovery preservation action applied to an archaeological object"@en .

arqo:ConservationDecision a owl:Class ;
    rdfs:subClassOf crm:E5_Event ;
    rdfs:label "ConservationDecision"@en ;
    rdfs:comment "Decision-making process determining conservation treatment based on stakeholder values"@en .

arqo:wasSampledIn a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:AnalyticalEncounter ;
    rdfs:label "wasSampledIn"@en .

arqo:underwentTreatment a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:ConservationTreatment ;
    rdfs:label "underwentTreatment"@en .

arqo:hasConservationDecision a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:ConservationDecision ;
    rdfs:label "hasConservationDecision"@en .

arqo:hasAnalyticalTechnique a owl:DatatypeProperty ;
    rdfs:domain arqo:AnalyticalEncounter ;
    rdfs:range xsd:string ;
    rdfs:label "hasAnalyticalTechnique"@en .

arqo:hasElementalComposition a owl:DatatypeProperty ;
    rdfs:domain arqo:MaterialAssignment ;
    rdfs:range xsd:string ;
    rdfs:label "hasElementalComposition"@en .

arqo:hasLeadIsotopeRatio a owl:DatatypeProperty ;
    rdfs:domain arqo:MaterialAssignment ;
    rdfs:range xsd:decimal ;
    rdfs:label "hasLeadIsotopeRatio"@en .

# Blocks 7-8 — Object Relations & Disputed Classification
# From DeepSeek analysis: Competing interpretations via CRMinf

arqo:hasCompetingInterpretation a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range crminf:I4_Proposition_Set ;
    rdfs:label "hasCompetingInterpretation"@en .

arqo:hasRepatriationDate a owl:DatatypeProperty ;
    rdfs:domain arqo:RepatriationEvent ;
    rdfs:range xsd:date ;
    rdfs:label "hasRepatriationDate"@en .

# ===================== RESTRICTIONS =======================
arqo:HumanMadeObject rdfs:subClassOf [
    rdf:type owl:Restriction ; owl:onProperty arqo:wasProducedBy ;
    owl:someValuesFrom arqo:ManufacturingEvent ] .

arqo:ArchaeologicalObject rdfs:subClassOf [
    rdf:type owl:Restriction ; owl:onProperty arqo:hasBiography ;
    owl:someValuesFrom arqo:ObjectBiography ] .
