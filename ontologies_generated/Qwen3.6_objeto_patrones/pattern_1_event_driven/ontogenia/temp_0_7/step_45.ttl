# ============================================================
# Ontology: Archaeological Object Module — Pattern: Pattern 1 Event Driven
# Model: qwen3.6 | Block-aware generation
# Strategy: ontogenia | Step: 45/50 | Block: 5
# CQ: CQ-OBJ-45 | Temperature: 0.7
# ============================================================

@prefix arqo: <http://www.ontologyARQ.org/archaeological-object/> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix crmarchaeo: <http://www.cidoc-crm.org/crmarchaeo/> .
@prefix crmsci: <http://www.cidoc-crm.org/crmsci/> .
@prefix crminf: <http://www.cidoc-crm.org/crminf/> .
@prefix crmhs: <http://www.cidoc-crm.org/crmhs/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

# ======================= CLASSES ===========================

# ─── Expert Taxonomy ───
arqo:ArchaeologicalObject a owl:Class ;
    rdfs:subClassOf crm:E19_Physical_Object ;
    rdfs:label "ArchaeologicalObject"@en ;
    rdfs:comment "Physical object recovered during archaeological investigation"@en .

arqo:NaturalObject a owl:Class ;
    rdfs:subClassOf arqo:ArchaeologicalObject ;
    rdfs:label "NaturalObject"@en ;
    rdfs:comment "Object of natural origin found in archaeological context (ecofact)"@en .

arqo:AbioticObject a owl:Class ;
    rdfs:subClassOf arqo:NaturalObject ;
    rdfs:label "AbioticObject"@en ;
    rdfs:comment "Non-living natural object (stone, mineral, sediment)"@en .

arqo:BioticObject a owl:Class ;
    rdfs:subClassOf arqo:NaturalObject ;
    rdfs:label "BioticObject"@en ;
    rdfs:comment "Living or once-living natural object (bone, shell, wood, plant remains)"@en .

arqo:HumanMadeObject a owl:Class ;
    rdfs:subClassOf arqo:ArchaeologicalObject ;
    owl:equivalentClass crm:E22_Human-Made_Object ;
    rdfs:label "HumanMadeObject"@en ;
    rdfs:comment "Object created or modified by human action"@en .

arqo:Artefact a owl:Class ;
    rdfs:subClassOf arqo:HumanMadeObject ;
    rdfs:label "Artefact"@en ;
    rdfs:comment "Portable human-made object with functional purpose"@en .

arqo:Structure a owl:Class ;
    rdfs:subClassOf arqo:HumanMadeObject ;
    rdfs:label "Structure"@en ;
    rdfs:comment "Non-portable human-made construction"@en .

arqo:ArtisticExpression a owl:Class ;
    rdfs:subClassOf arqo:HumanMadeObject ;
    rdfs:label "ArtisticExpression"@en ;
    rdfs:comment "Human-made object with aesthetic or symbolic function"@en .

# Block 5 — Custodia, exhibición y patrimonialización
# Qwen: CustodyEvent, CustodyChain, ConservationTreatment, ConservationDecision,
# ExhibitionEvent, DigitalReplica, HeritageClaim, Pastness, Patina

arqo:CustodyEvent a owl:Class ;
    rdfs:subClassOf crm:E7_Activity ;
    rdfs:label "CustodyEvent"@en ;
    rdfs:comment "Event managing an archaeological object through excavation, storage, loan, or exhibition"@en .

arqo:CustodyChain a owl:Class ;
    rdfs:subClassOf crm:E5_Event ;
    rdfs:label "CustodyChain"@en ;
    rdfs:comment "Complete chain of custody from recovery to current institutional location"@en .

arqo:ConservationTreatment a owl:Class ;
    rdfs:subClassOf crm:E7_Activity ;
    rdfs:label "ConservationTreatment"@en ;
    rdfs:comment "Post-recovery preservation action applied to an archaeological object"@en .

arqo:ConservationDecision a owl:Class ;
    rdfs:subClassOf crm:E5_Event ;
    rdfs:label "ConservationDecision"@en ;
    rdfs:comment "Decision-making process determining conservation treatment based on stakeholder values"@en .

arqo:ExhibitionEvent a owl:Class ;
    rdfs:subClassOf crm:E7_Activity ;
    rdfs:label "ExhibitionEvent"@en ;
    rdfs:comment "Event of publicly exhibiting an archaeological object"@en .

arqo:DigitalReplica a owl:Class ;
    rdfs:subClassOf crm:E73_Information_Object ;
    rdfs:label "DigitalReplica"@en ;
    rdfs:comment "Digital representation of an archaeological object (3D model, photogrammetry, etc.)"@en .

arqo:HeritageClaim a owl:Class ;
    rdfs:subClassOf crminf:I4_Proposition_Set ;
    rdfs:label "HeritageClaim"@en ;
    rdfs:comment "Claim over cultural heritage ownership or repatriation of an archaeological object"@en .

arqo:Pastness a owl:Class ;
    rdfs:subClassOf crminf:I4_Proposition_Set ;
    rdfs:label "Pastness"@en ;
    rdfs:comment "Perceived quality of being from the past — culturally constructed aesthetic and cognitive experience"@en .

arqo:Patina a owl:Class ;
    rdfs:subClassOf crm:E3_Condition_State ;
    rdfs:label "Patina"@en ;
    rdfs:comment "Physical surface alteration connoting age, valued culturally as authenticity evidence"@en .

arqo:managedByCustodyEvent a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:CustodyEvent ;
    rdfs:label "managedByCustodyEvent"@en .

arqo:hasCustodyChain a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:CustodyChain ;
    rdfs:label "hasCustodyChain"@en .

arqo:underwentConservationTreatment a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:ConservationTreatment ;
    rdfs:label "underwentConservationTreatment"@en .

arqo:hasConservationDecision a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:ConservationDecision ;
    rdfs:label "hasConservationDecision"@en .

arqo:exhibitedIn a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:ExhibitionEvent ;
    rdfs:label "exhibitedIn"@en .

arqo:hasDigitalReplica a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:DigitalReplica ;
    rdfs:label "hasDigitalReplica"@en .

arqo:subjectOfHeritageClaim a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:HeritageClaim ;
    rdfs:label "subjectOfHeritageClaim"@en .

arqo:wasRepatriatedIn a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:RepatriationEvent ;
    rdfs:label "wasRepatriatedIn"@en .

arqo:exhibitsPastness a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:Pastness ;
    rdfs:label "exhibitsPastness"@en .

arqo:hasPatina a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:Patina ;
    rdfs:label "hasPatina"@en .

arqo:hasCustodyDate a owl:DatatypeProperty ;
    rdfs:domain arqo:CustodyEvent ;
    rdfs:range xsd:dateTime ;
    rdfs:label "hasCustodyDate"@en .

arqo:hasConservationDecisionReason a owl:DatatypeProperty ;
    rdfs:domain arqo:ConservationDecision ;
    rdfs:range xsd:string ;
    rdfs:label "hasConservationDecisionReason"@en .

arqo:hasExhibitionDate a owl:DatatypeProperty ;
    rdfs:domain arqo:ExhibitionEvent ;
    rdfs:range xsd:dateTime ;
    rdfs:label "hasExhibitionDate"@en .

arqo:hasDocumentationTechnique a owl:DatatypeProperty ;
    rdfs:domain arqo:DigitalReplica ;
    rdfs:range xsd:string ;
    rdfs:label "hasDocumentationTechnique"@en .

arqo:hasHeritageClaimType a owl:DatatypeProperty ;
    rdfs:domain arqo:HeritageClaim ;
    rdfs:range xsd:string ;
    rdfs:label "hasHeritageClaimType"@en .

arqo:hasRepatriationDate a owl:DatatypeProperty ;
    rdfs:domain arqo:RepatriationEvent ;
    rdfs:range xsd:date ;
    rdfs:label "hasRepatriationDate"@en .

arqo:hasObjectAgeValue a owl:DatatypeProperty ;
    rdfs:domain arqo:Pastness ;
    rdfs:range xsd:string ;
    rdfs:label "hasObjectAgeValue"@en .

arqo:hasCulturalSignificance a owl:DatatypeProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range xsd:string ;
    rdfs:label "hasCulturalSignificance"@en .

# Block 1 — Biografía del objeto como entidad histórica
# Qwen: ObjectBiography, ObjectLifecycle, ManufacturingEvent, UseEvent, ReuseEvent,
# RepairEvent, DepositionEvent, RecoveryEvent, CirculationEvent, RepatriationEvent,
# FunctionalTransformation

arqo:ObjectBiography a owl:Class ;
    rdfs:subClassOf crm:E5_Event ;
    rdfs:label "ObjectBiography"@en ;
    rdfs:comment "Narrative sequence of events constituting the lifecycle of an archaeological object"@en .

arqo:ObjectLifecycle a owl:Class ;
    rdfs:subClassOf crm:E5_Event ;
    rdfs:label "ObjectLifecycle"@en ;
    rdfs:comment "Physical sequence of states and transitions from manufacture through deposition"@en .

arqo:ManufacturingEvent a owl:Class ;
    rdfs:subClassOf crm:E12_Production ;
    rdfs:label "ManufacturingEvent"@en ;
    rdfs:comment "Event of object production through specific technological procedures"@en .

arqo:UseEvent a owl:Class ;
    rdfs:subClassOf crm:E7_Activity ;
    rdfs:label "UseEvent"@en ;
    rdfs:comment "Event of object utilization in its original or assigned functional role"@en .

arqo:ReuseEvent a owl:Class ;
    rdfs:subClassOf crm:E7_Activity ;
    rdfs:label "ReuseEvent"@en ;
    rdfs:comment "Secondary use of an object for a function different from its original intended use"@en .

arqo:RepairEvent a owl:Class ;
    rdfs:subClassOf crm:E81_Transformation ;
    rdfs:label "RepairEvent"@en ;
    rdfs:comment "Physical modification of an object to restore function or extend use-life"@en .

arqo:DepositionEvent a owl:Class ;
    rdfs:subClassOf crmarchaeo:A4_Stratigraphic_Genesis ;
    rdfs:label "DepositionEvent"@en ;
    rdfs:comment "Event of an object entering the archaeological record through intentional or accidental discard"@en .

arqo:RecoveryEvent a owl:Class ;
    rdfs:subClassOf crmarchaeo:A1_Excavation_Process_Unit ;
    rdfs:label "RecoveryEvent"@en ;
    rdfs:comment "Event of object being excavated or recovered from depositional context"@en .

arqo:CirculationEvent a owl:Class ;
    rdfs:subClassOf crm:E9_Move ;
    rdfs:label "CirculationEvent"@en ;
    rdfs:comment "Event of an object moving between geographic locations or cultural zones during use-life"@en .

arqo:RepatriationEvent a owl:Class ;
    rdfs:subClassOf crm:E9_Move ;
    rdfs:label "RepatriationEvent"@en ;
    rdfs:comment "Event of returning an archaeological object to its country or community of origin"@en .

arqo:FunctionalTransformation a owl:Class ;
    rdfs:subClassOf crm:E81_Transformation ;
    rdfs:label "FunctionalTransformation"@en ;
    rdfs:comment "Change in the functional role of an object during its active use-life"@en .

arqo:hasBiography a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:ObjectBiography ;
    rdfs:label "hasBiography"@en .

arqo:hasLifecycle a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:ObjectLifecycle ;
    rdfs:label "hasLifecycle"@en .

arqo:wasProducedBy a owl:ObjectProperty ;
    rdfs:domain arqo:HumanMadeObject ;
    rdfs:range arqo:ManufacturingEvent ;
    rdfs:label "wasProducedBy"@en .

arqo:wasUsedIn a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:UseEvent ;
    rdfs:label "wasUsedIn"@en .

arqo:wasReusedIn a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:ReuseEvent ;
    rdfs:label "wasReusedIn"@en .

arqo:wasRepairedIn a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:RepairEvent ;
    rdfs:label "wasRepairedIn"@en .

arqo:wasDepositedIn a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:DepositionEvent ;
    rdfs:label "wasDepositedIn"@en .

arqo:wasRecoveredIn a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:RecoveryEvent ;
    rdfs:label "wasRecoveredIn"@en .

arqo:circulatedThrough a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:CirculationEvent ;
    rdfs:label "circulatedThrough"@en .

arqo:wasRepatriatedIn a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:RepatriationEvent ;
    rdfs:label "wasRepatriatedIn"@en .

arqo:underwentFunctionalTransformation a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:FunctionalTransformation ;
    rdfs:label "underwentFunctionalTransformation"@en .

arqo:hasManufacturingDateStart a owl:DatatypeProperty ;
    rdfs:domain arqo:ManufacturingEvent ;
    rdfs:range xsd:dateTime ;
    rdfs:label "hasManufacturingDateStart"@en .

arqo:hasManufacturingDateEnd a owl:DatatypeProperty ;
    rdfs:domain arqo:ManufacturingEvent ;
    rdfs:range xsd:dateTime ;
    rdfs:label "hasManufacturingDateEnd"@en .

arqo:hasUseDateStart a owl:DatatypeProperty ;
    rdfs:domain arqo:UseEvent ;
    rdfs:range xsd:dateTime ;
    rdfs:label "hasUseDateStart"@en .

arqo:hasUseDateEnd a owl:DatatypeProperty ;
    rdfs:domain arqo:UseEvent ;
    rdfs:range xsd:dateTime ;
    rdfs:label "hasUseDateEnd"@en .

arqo:hasDepositionDate a owl:DatatypeProperty ;
    rdfs:domain arqo:DepositionEvent ;
    rdfs:range xsd:dateTime ;
    rdfs:label "hasDepositionDate"@en .

arqo:hasTerminusPostQuem a owl:DatatypeProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range xsd:dateTime ;
    rdfs:label "hasTerminusPostQuem"@en .

arqo:hasTerminusAnteQuem a owl:DatatypeProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range xsd:dateTime ;
    rdfs:label "hasTerminusAnteQuem"@en .

arqo:hasLifespanDuration a owl:DatatypeProperty ;
    rdfs:domain arqo:ObjectLifecycle ;
    rdfs:range xsd:duration ;
    rdfs:label "hasLifespanDuration"@en .

# Block 2 — Workflows analíticos y trazabilidad científica
# Qwen: AnalyticalEncounter, AnalyticalWorkflow, SamplingEvent, MeasurementEvent,
# CalibrationEvent, AnalyticalDataset, AnalyticalObservation, InterpretiveConclusion

arqo:AnalyticalEncounter a owl:Class ;
    rdfs:subClassOf crmsci:S19_Encounter ;
    rdfs:label "AnalyticalEncounter"@en ;
    rdfs:comment "Scientific analysis event where physical or chemical properties of an object are measured"@en .

arqo:AnalyticalWorkflow a owl:Class ;
    rdfs:subClassOf crm:E5_Event ;
    rdfs:label "AnalyticalWorkflow"@en ;
    rdfs:comment "Complete chain of analytical events from sampling through interpretation"@en .

arqo:SamplingEvent a owl:Class ;
    rdfs:subClassOf crmsci:S18_Sample ;
    rdfs:label "SamplingEvent"@en ;
    rdfs:comment "Event of taking a physical sample from an archaeological object"@en .

arqo:MeasurementEvent a owl:Class ;
    rdfs:subClassOf crmsci:S21_Measurement ;
    rdfs:label "MeasurementEvent"@en ;
    rdfs:comment "Event of measuring physical or chemical properties of an object or sample"@en .

arqo:CalibrationEvent a owl:Class ;
    rdfs:subClassOf crmsci:S5_Inference_Making ;
    rdfs:label "CalibrationEvent"@en ;
    rdfs:comment "Process of converting raw measurements to calibrated values"@en .

arqo:AnalyticalDataset a owl:Class ;
    rdfs:subClassOf crm:E73_Information_Carrier ;
    rdfs:label "AnalyticalDataset"@en ;
    rdfs:comment "Dataset generated during scientific analysis of an archaeological object"@en .

arqo:AnalyticalObservation a owl:Class ;
    rdfs:subClassOf crmsci:S4_Observation ;
    rdfs:label "AnalyticalObservation"@en ;
    rdfs:comment "Empirical measurement or observation of object properties"@en .

arqo:InterpretiveConclusion a owl:Class ;
    rdfs:subClassOf crminf:I4_Proposition_Set ;
    rdfs:label "InterpretiveConclusion"@en ;
    rdfs:comment "Researcher conclusion drawn from analytical observations"@en .

arqo:wasSampledIn a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:AnalyticalEncounter ;
    rdfs:label "wasSampledIn"@en .

arqo:underwentMeasurement a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:MeasurementEvent ;
    rdfs:label "underwentMeasurement"@en .

arqo:underwentCalibration a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:CalibrationEvent ;
    rdfs:label "underwentCalibration"@en .

arqo:generatedDataset a owl:ObjectProperty ;
    rdfs:domain arqo:AnalyticalEncounter ;
    rdfs:range arqo:AnalyticalDataset ;
    rdfs:label "generatedDataset"@en .

arqo:hasAnalyticalObservation a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:AnalyticalObservation ;
    rdfs:label "hasAnalyticalObservation"@en .

arqo:hasInterpretiveConclusion a owl:ObjectProperty ;
    rdfs:domain arqo:AnalyticalWorkflow ;
    rdfs:range arqo:InterpretiveConclusion ;
    rdfs:label "hasInterpretiveConclusion"@en .

arqo:hasMaterial a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range crm:E57_Material ;
    rdfs:label "hasMaterial"@en .

arqo:hasAnalyticalTechnique a owl:DatatypeProperty ;
    rdfs:domain arqo:AnalyticalEncounter ;
    rdfs:range xsd:string ;
    rdfs:label "hasAnalyticalTechnique"@en .

arqo:hasRadiocarbonAge a owl:DatatypeProperty ;
    rdfs:domain arqo:CalibrationEvent ;
    rdfs:range xsd:decimal ;
    rdfs:label "hasRadiocarbonAge"@en .

arqo:hasCalibratedAgeInterval a owl:DatatypeProperty ;
    rdfs:domain arqo:CalibrationEvent ;
    rdfs:range xsd:string ;
    rdfs:label "hasCalibratedAgeInterval"@en .

arqo:hasDatingMethod a owl:DatatypeProperty ;
    rdfs:domain arqo:CalibrationEvent ;
    rdfs:range xsd:string ;
    rdfs:label "hasDatingMethod"@en .

arqo:hasLocalIdentifier a owl:DatatypeProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range xsd:string ;
    rdfs:label "hasLocalIdentifier"@en .

# Block 3 — Interpretación disputada y multivocalidad
# Qwen: InterpretiveHypothesis, CompetingInterpretation, RejectedHypothesis,
# CertaintyAssessment, ArgumentativeChain, TypologicalAssignment,
# ChronologicalAssignment, InterpretiveConflict

arqo:InterpretiveHypothesis a owl:Class ;
    rdfs:subClassOf crminf:I4_Proposition_Set ;
    rdfs:label "InterpretiveHypothesis"@en ;
    rdfs:comment "Researcher hypothesis about function, chronology, or cultural meaning of an object"@en .

arqo:CompetingInterpretation a owl:Class ;
    rdfs:subClassOf crminf:I4_Proposition_Set ;
    rdfs:label "CompetingInterpretation"@en ;
    rdfs:comment "Rival hypothesis about object properties or meaning"@en .

arqo:RejectedHypothesis a owl:Class ;
    rdfs:subClassOf crminf:I4_Proposition_Set ;
    rdfs:label "RejectedHypothesis"@en ;
    rdfs:comment "Interpretive hypothesis that was discarded based on evidence"@en .

arqo:CertaintyAssessment a owl:Class ;
    rdfs:subClassOf crminf:I4_Proposition_Set ;
    rdfs:label "CertaintyAssessment"@en ;
    rdfs:comment "Assessment of confidence level assigned to an archaeological interpretation"@en .

arqo:ArgumentativeChain a owl:Class ;
    rdfs:subClassOf crm:E5_Event ;
    rdfs:label "ArgumentativeChain"@en ;
    rdfs:comment "Chain connecting empirical observations, measurements, and interpretive inferences"@en .

arqo:TypologicalAssignment a owl:Class ;
    rdfs:subClassOf crm:E17_Type_Assignment ;
    rdfs:label "TypologicalAssignment"@en ;
    rdfs:comment "Researcher assignment of an object to a typological category based on diagnostic criteria"@en .

arqo:ChronologicalAssignment a owl:Class ;
    rdfs:subClassOf crm:E17_Type_Assignment ;
    rdfs:label "ChronologicalAssignment"@en ;
    rdfs:comment "Researcher assignment of an archaeological object or event to a temporal period"@en .

arqo:InterpretiveConflict a owl:Class ;
    rdfs:subClassOf crminf:I4_Proposition_Set ;
    rdfs:label "InterpretiveConflict"@en ;
    rdfs:comment "Conflict between different researchers regarding object interpretation"@en .

arqo:hasInterpretiveHypothesis a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:InterpretiveHypothesis ;
    rdfs:label "hasInterpretiveHypothesis"@en .

arqo:hasCompetingInterpretation a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:CompetingInterpretation ;
    rdfs:label "hasCompetingInterpretation"@en .

arqo:hasRejectedHypothesis a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:RejectedHypothesis ;
    rdfs:label "hasRejectedHypothesis"@en .

arqo:hasCertaintyAssessment a owl:ObjectProperty ;
    rdfs:domain arqo:InterpretiveHypothesis ;
    rdfs:range arqo:CertaintyAssessment ;
    rdfs:label "hasCertaintyAssessment"@en .

arqo:hasArgumentativeChain a owl:ObjectProperty ;
    rdfs:domain arqo:InterpretiveHypothesis ;
    rdfs:range arqo:ArgumentativeChain ;
    rdfs:label "hasArgumentativeChain"@en .

arqo:hasTypologicalAssignment a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:TypologicalAssignment ;
    rdfs:label "hasTypologicalAssignment"@en .

arqo:hasChronologicalAssignment a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:ChronologicalAssignment ;
    rdfs:label "hasChronologicalAssignment"@en .

arqo:hasInterpretiveConflict a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:InterpretiveConflict ;
    rdfs:label "hasInterpretiveConflict"@en .

arqo:hasCertaintyLevel a owl:DatatypeProperty ;
    rdfs:domain arqo:CertaintyAssessment ;
    rdfs:range xsd:decimal ;
    rdfs:label "hasCertaintyLevel"@en .

arqo:hasConfidenceDegree a owl:DatatypeProperty ;
    rdfs:domain arqo:CertaintyAssessment ;
    rdfs:range xsd:string ;
    rdfs:label "hasConfidenceDegree"@en .

arqo:hasRejectionReason a owl:DatatypeProperty ;
    rdfs:domain arqo:RejectedHypothesis ;
    rdfs:range xsd:string ;
    rdfs:label "hasRejectionReason"@en .

arqo:hasInterpretiveFramework a owl:DatatypeProperty ;
    rdfs:domain arqo:InterpretiveHypothesis ;
    rdfs:range xsd:string ;
    rdfs:label "hasInterpretiveFramework"@en .

# Block 4 — Tafonomía y procesos formativos
# Qwen: TaphonomicProcess, TaphonomicAlterationEvent, FragmentationEvent,
# GeomorphologicalEvent, PostDepositionalDisplacement, FragmentationState,
# PatinaState, CorrosionState, WeatheringState, IntegrityState

arqo:TaphonomicProcess a owl:Class ;
    rdfs:subClassOf crmarchaeo:A5_Stratigraphic_Modification_Event ;
    rdfs:label "TaphonomicProcess"@en ;
    rdfs:comment "Natural process altering position, condition, or integrity of an object since deposition"@en .

arqo:TaphonomicAlterationEvent a owl:Class ;
    rdfs:subClassOf crmarchaeo:A5_Stratigraphic_Modification_Event ;
    rdfs:label "TaphonomicAlterationEvent"@en ;
    rdfs:comment "Specific taphonomic event altering an object's state"@en .

arqo:FragmentationEvent a owl:Class ;
    rdfs:subClassOf crm:E81_Transformation ;
    rdfs:label "FragmentationEvent"@en ;
    rdfs:comment "Process producing fragments from an originally complete object"@en .

arqo:GeomorphologicalEvent a owl:Class ;
    rdfs:subClassOf crm:E5_Event ;
    rdfs:label "GeomorphologicalEvent"@en ;
    rdfs:comment "Natural geomorphological event affecting depositional context"@en .

arqo:PostDepositionalDisplacement a owl:Class ;
    rdfs:subClassOf crm:E9_Move ;
    rdfs:label "PostDepositionalDisplacement"@en ;
    rdfs:comment "Movement of an object from its primary depositional context"@en .

arqo:FragmentationState a owl:Class ;
    rdfs:subClassOf crm:E3_Condition_State ;
    rdfs:label "FragmentationState"@en ;
    rdfs:comment "Physical state where an object exists as multiple disconnected fragments"@en .

arqo:PatinaState a owl:Class ;
    rdfs:subClassOf crm:E3_Condition_State ;
    rdfs:label "PatinaState"@en ;
    rdfs:comment "Surface alteration connoting age, valued culturally as authenticity evidence"@en .

arqo:CorrosionState a owl:Class ;
    rdfs:subClassOf crm:E3_Condition_State ;
    rdfs:label "CorrosionState"@en ;
    rdfs:comment "Chemical degradation state of metallic objects"@en .

arqo:WeatheringState a owl:Class ;
    rdfs:subClassOf crm:E3_Condition_State ;
    rdfs:label "WeatheringState"@en ;
    rdfs:comment "Physical degradation from environmental exposure"@en .

arqo:IntegrityState a owl:Class ;
    rdfs:subClassOf crm:E3_Condition_State ;
    rdfs:label "IntegrityState"@en ;
    rdfs:comment "Degree of physical completeness of an object"@en .

arqo:DisplacedState a owl:Class ;
    rdfs:subClassOf crm:E3_Condition_State ;
    rdfs:label "DisplacedState"@en ;
    rdfs:comment "State of an object that has been moved from its primary depositional context"@en .

arqo:underwentTaphonomicProcess a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:TaphonomicProcess ;
    rdfs:label "underwentTaphonomicProcess"@en .

arqo:underwentFragmentation a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:FragmentationEvent ;
    rdfs:label "underwentFragmentation"@en .

arqo:affectedByGeomorphologicalEvent a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:GeomorphologicalEvent ;
    rdfs:label "affectedByGeomorphologicalEvent"@en .

arqo:wasDisplacedBy a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:PostDepositionalDisplacement ;
    rdfs:label "wasDisplacedBy"@en .

arqo:hasFragmentationState a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:FragmentationState ;
    rdfs:label "hasFragmentationState"@en .

arqo:hasPatinaState a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:PatinaState ;
    rdfs:label "hasPatinaState"@en .

arqo:hasCorrosionState a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:CorrosionState ;
    rdfs:label "hasCorrosionState"@en .

arqo:hasWeatheringState a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:WeatheringState ;
    rdfs:label "hasWeatheringState"@en .

arqo:hasIntegrityState a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:IntegrityState ;
    rdfs:label "hasIntegrityState"@en .

arqo:hasDisplacedState a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:DisplacedState ;
    rdfs:label "hasDisplacedState"@en .

arqo:isFragmentedInto a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:ArchaeologicalObject ;
    rdfs:label "isFragmentedInto"@en .

arqo:hasTaphonomicProcessType a owl:DatatypeProperty ;
    rdfs:domain arqo:TaphonomicProcess ;
    rdfs:range xsd:string ;
    rdfs:label "hasTaphonomicProcessType"@en .

arqo:hasFragmentationCause a owl:DatatypeProperty ;
    rdfs:domain arqo:FragmentationEvent ;
    rdfs:range xsd:string ;
    rdfs:label "hasFragmentationCause"@en .

arqo:hasGeomorphologicalProcessType a owl:DatatypeProperty ;
    rdfs:domain arqo:GeomorphologicalEvent ;
    rdfs:range xsd:string ;
    rdfs:label "hasGeomorphologicalProcessType"@en .

arqo:hasDisplacementDistance a owl:DatatypeProperty ;
    rdfs:domain arqo:PostDepositionalDisplacement ;
    rdfs:range xsd:decimal ;
    rdfs:label "hasDisplacementDistance"@en .

arqo:hasConservationState a owl:DatatypeProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range xsd:string ;
    rdfs:label "hasConservationState"@en .

arqo:hasPreservationRating a owl:DatatypeProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range xsd:decimal ;
    rdfs:label "hasPreservationRating"@en .

# ===================== RESTRICTIONS =======================
arqo:NaturalObject owl:disjointWith arqo:HumanMadeObject .
arqo:AbioticObject owl:disjointWith arqo:BioticObject .
arqo:Artefact owl:disjointWith arqo:Structure .

arqo:HumanMadeObject rdfs:subClassOf [
    rdf:type owl:Restriction ; owl:onProperty arqo:wasProducedBy ;
    owl:someValuesFrom arqo:ManufacturingEvent ] .

arqo:ArchaeologicalObject rdfs:subClassOf [
    rdf:type owl:Restriction ; owl:onProperty arqo:hasBiography ;
    owl:someValuesFrom arqo:ObjectBiography ] .

arqo:DepositionEvent rdfs:subClassOf [
    rdf:type owl:Restriction ; owl:onProperty arqo:hasDepositionDate ;
    owl:cardinality "1"^^xsd:nonNegativeInteger ] .

arqo:ManufacturingEvent rdfs:subClassOf [
    rdf:type owl:Restriction ; owl:onProperty arqo:hasManufacturingDateStart ;
    owl:cardinality "1"^^xsd:nonNegativeInteger ] .
