# ============================================================
# Ontology: Archaeological Object Module — Pattern: Pattern 1 Event Driven
# Model: qwen3.6 | Block-aware generation
# Strategy: memoryless | CQ: CQ-OBJ-47 | Block: 6
# Temperature: 0.7
# ============================================================

@prefix arqo: <http://www.ontologyARQ.org/archaeological-object/> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix crmarchaeo: <http://www.cidoc-crm.org/crmarchaeo/> .
@prefix crmsci: <http://www.cidoc-crm.org/crmsci/> .
@prefix crminf: <http://www.cidoc-crm.org/crminf/> .
@prefix crmhs: <http://www.cidoc-crm.org/crmhs/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

# ======================= CLASSES ===========================

# ─── Expert Taxonomy ───
arqo:ArchaeologicalObject a owl:Class ;
    rdfs:subClassOf crm:E19_Physical_Object ;
    rdfs:label "ArchaeologicalObject"@en ;
    rdfs:comment "Physical object recovered during archaeological investigation"@en .

arqo:NaturalObject a owl:Class ;
    rdfs:subClassOf arqo:ArchaeologicalObject ;
    rdfs:label "NaturalObject"@en ;
    rdfs:comment "Object of natural origin found in archaeological context (ecofact)"@en .

arqo:AbioticObject a owl:Class ;
    rdfs:subClassOf arqo:NaturalObject ;
    rdfs:label "AbioticObject"@en ;
    rdfs:comment "Non-living natural object (stone, mineral, sediment)"@en .

arqo:BioticObject a owl:Class ;
    rdfs:subClassOf arqo:NaturalObject ;
    rdfs:label "BioticObject"@en ;
    rdfs:comment "Living or once-living natural object (bone, shell, wood, plant remains)"@en .

arqo:HumanMadeObject a owl:Class ;
    rdfs:subClassOf arqo:ArchaeologicalObject ;
    owl:equivalentClass crm:E22_Human-Made_Object ;
    rdfs:label "HumanMadeObject"@en ;
    rdfs:comment "Object created or modified by human action"@en .

arqo:Artefact a owl:Class ;
    rdfs:subClassOf arqo:HumanMadeObject ;
    rdfs:label "Artefact"@en ;
    rdfs:comment "Portable human-made object with functional purpose"@en .

arqo:Structure a owl:Class ;
    rdfs:subClassOf arqo:HumanMadeObject ;
    rdfs:label "Structure"@en ;
    rdfs:comment "Non-portable human-made construction"@en .

arqo:ArtisticExpression a owl:Class ;
    rdfs:subClassOf arqo:HumanMadeObject ;
    rdfs:label "ArtisticExpression"@en ;
    rdfs:comment "Human-made object with aesthetic or symbolic function"@en .

# Block 6 — Correlación objeto-contexto-territorio
# Qwen: SpatialCorrelationEvent, CirculationNetwork, FunctionalZone, OccupationPhase,
# PaleoenvironmentalCorrelation, SpatialContext, TerritorialDistribution,
# GeologicalCorrelation

arqo:SpatialCorrelationEvent a owl:Class ;
    rdfs:subClassOf crm:E5_Event ;
    rdfs:label "SpatialCorrelationEvent"@en ;
    rdfs:comment "Event correlating an object spatially with other finds or architectural structures"@en .

arqo:CirculationNetwork a owl:Class ;
    rdfs:subClassOf crm:E5_Event ;
    rdfs:label "CirculationNetwork"@en ;
    rdfs:comment "Network of exchange or mobility through which objects circulated"@en .

arqo:FunctionalZone a owl:Class ;
    rdfs:subClassOf crm:E53_Place ;
    rdfs:label "FunctionalZone"@en ;
    rdfs:comment "Spatial area within a site with specific functional purpose (domestic, ritual, production, funerary)"@en .

arqo:OccupationPhase a owl:Class ;
    rdfs:subClassOf crm:E5_Event ;
    rdfs:label "OccupationPhase"@en ;
    rdfs:comment "Phase of occupation, abandonment, or reoccupation of a settlement"@en .

arqo:PaleoenvironmentalCorrelation a owl:Class ;
    rdfs:subClassOf crm:E5_Event ;
    rdfs:label "PaleoenvironmentalCorrelation"@en ;
    rdfs:comment "Correlation between object distribution and paleoenvironmental conditions"@en .

arqo:SpatialContext a owl:Class ;
    rdfs:subClassOf crm:E53_Place ;
    rdfs:label "SpatialContext"@en ;
    rdfs:comment "Spatial context in which an archaeological object was found"@en .

arqo:TerritorialDistribution a owl:Class ;
    rdfs:subClassOf crm:E5_Event ;
    rdfs:label "TerritorialDistribution"@en ;
    rdfs:comment "Territorial distribution pattern of objects of a cultural type"@en .

arqo:GeologicalCorrelation a owl:Class ;
    rdfs:subClassOf crm:E5_Event ;
    rdfs:label "GeologicalCorrelation"@en ;
    rdfs:comment "Correlation between object distribution and geological units or processes"@en .

arqo:correlatedInEvent a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:SpatialCorrelationEvent ;
    rdfs:label "correlatedInEvent"@en .

arqo:circulatedInNetwork a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:CirculationNetwork ;
    rdfs:label "circulatedInNetwork"@en .

arqo:locatedInZone a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:FunctionalZone ;
    rdfs:label "locatedInZone"@en .

arqo:partOfOccupationPhase a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:OccupationPhase ;
    rdfs:label "partOfOccupationPhase"@en .

arqo:correlatedWithPaleoenvironment a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:PaleoenvironmentalCorrelation ;
    rdfs:label "correlatedWithPaleoenvironment"@en .

arqo:foundInSpatialContext a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:SpatialContext ;
    rdfs:label "foundInSpatialContext"@en .

arqo:partOfTerritorialDistribution a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:TerritorialDistribution ;
    rdfs:label "partOfTerritorialDistribution"@en .

arqo:correlatedWithGeologicalUnit a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:GeologicalCorrelation ;
    rdfs:label "correlatedWithGeologicalUnit"@en .

arqo:hasSpatialRelationType a owl:DatatypeProperty ;
    rdfs:domain arqo:SpatialCorrelationEvent ;
    rdfs:range xsd:string ;
    rdfs:label "hasSpatialRelationType"@en .

arqo:hasNetworkExtent a owl:DatatypeProperty ;
    rdfs:domain arqo:CirculationNetwork ;
    rdfs:range xsd:string ;
    rdfs:label "hasNetworkExtent"@en .

arqo:hasZoneFunction a owl:DatatypeProperty ;
    rdfs:domain arqo:FunctionalZone ;
    rdfs:range xsd:string ;
    rdfs:label "hasZoneFunction"@en .

arqo:hasPhaseChronology a owl:DatatypeProperty ;
    rdfs:domain arqo:OccupationPhase ;
    rdfs:range xsd:string ;
    rdfs:label "hasPhaseChronology"@en .

arqo:hasPaleoenvironmentalType a owl:DatatypeProperty ;
    rdfs:domain arqo:PaleoenvironmentalCorrelation ;
    rdfs:range xsd:string ;
    rdfs:label "hasPaleoenvironmentalType"@en .

arqo:hasGeologicalPeriod a owl:DatatypeProperty ;
    rdfs:domain arqo:GeologicalCorrelation ;
    rdfs:range xsd:string ;
    rdfs:label "hasGeologicalPeriod"@en .

# ===================== RESTRICTIONS =======================
arqo:NaturalObject owl:disjointWith arqo:HumanMadeObject .
arqo:AbioticObject owl:disjointWith arqo:BioticObject .
arqo:Artefact owl:disjointWith arqo:Structure .

arqo:HumanMadeObject rdfs:subClassOf [
    rdf:type owl:Restriction ; owl:onProperty arqo:wasProducedBy ;
    owl:someValuesFrom arqo:ManufacturingEvent ] .

arqo:ArchaeologicalObject rdfs:subClassOf [
    rdf:type owl:Restriction ; owl:onProperty arqo:hasBiography ;
    owl:someValuesFrom arqo:ObjectBiography ] .

arqo:DepositionEvent rdfs:subClassOf [
    rdf:type owl:Restriction ; owl:onProperty arqo:hasDepositionDate ;
    owl:cardinality "1"^^xsd:nonNegativeInteger ] .

arqo:ManufacturingEvent rdfs:subClassOf [
    rdf:type owl:Restriction ; owl:onProperty arqo:hasManufacturingDateStart ;
    owl:cardinality "1"^^xsd:nonNegativeInteger ] .
