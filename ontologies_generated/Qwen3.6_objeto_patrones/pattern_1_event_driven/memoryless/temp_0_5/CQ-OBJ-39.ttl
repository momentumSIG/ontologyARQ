# ============================================================
# Ontology: Archaeological Object Module — Pattern: Pattern 1 Event Driven
# Model: qwen3.6 | Block-aware generation
# Strategy: memoryless | CQ: CQ-OBJ-39 | Block: 4
# Temperature: 0.5
# ============================================================

@prefix arqo: <http://www.ontologyARQ.org/archaeological-object/> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix crmarchaeo: <http://www.cidoc-crm.org/crmarchaeo/> .
@prefix crmsci: <http://www.cidoc-crm.org/crmsci/> .
@prefix crminf: <http://www.cidoc-crm.org/crminf/> .
@prefix crmhs: <http://www.cidoc-crm.org/crmhs/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

# ======================= CLASSES ===========================

# ─── Expert Taxonomy ───
arqo:ArchaeologicalObject a owl:Class ;
    rdfs:subClassOf crm:E19_Physical_Object ;
    rdfs:label "ArchaeologicalObject"@en ;
    rdfs:comment "Physical object recovered during archaeological investigation"@en .

arqo:NaturalObject a owl:Class ;
    rdfs:subClassOf arqo:ArchaeologicalObject ;
    rdfs:label "NaturalObject"@en ;
    rdfs:comment "Object of natural origin found in archaeological context (ecofact)"@en .

arqo:AbioticObject a owl:Class ;
    rdfs:subClassOf arqo:NaturalObject ;
    rdfs:label "AbioticObject"@en ;
    rdfs:comment "Non-living natural object (stone, mineral, sediment)"@en .

arqo:BioticObject a owl:Class ;
    rdfs:subClassOf arqo:NaturalObject ;
    rdfs:label "BioticObject"@en ;
    rdfs:comment "Living or once-living natural object (bone, shell, wood, plant remains)"@en .

arqo:HumanMadeObject a owl:Class ;
    rdfs:subClassOf arqo:ArchaeologicalObject ;
    owl:equivalentClass crm:E22_Human-Made_Object ;
    rdfs:label "HumanMadeObject"@en ;
    rdfs:comment "Object created or modified by human action"@en .

arqo:Artefact a owl:Class ;
    rdfs:subClassOf arqo:HumanMadeObject ;
    rdfs:label "Artefact"@en ;
    rdfs:comment "Portable human-made object with functional purpose"@en .

arqo:Structure a owl:Class ;
    rdfs:subClassOf arqo:HumanMadeObject ;
    rdfs:label "Structure"@en ;
    rdfs:comment "Non-portable human-made construction"@en .

arqo:ArtisticExpression a owl:Class ;
    rdfs:subClassOf arqo:HumanMadeObject ;
    rdfs:label "ArtisticExpression"@en ;
    rdfs:comment "Human-made object with aesthetic or symbolic function"@en .

# Block 4 — Tafonomía y procesos formativos
# Qwen: TaphonomicProcess, TaphonomicAlterationEvent, FragmentationEvent,
# GeomorphologicalEvent, PostDepositionalDisplacement, FragmentationState,
# PatinaState, CorrosionState, WeatheringState, IntegrityState

arqo:TaphonomicProcess a owl:Class ;
    rdfs:subClassOf crmarchaeo:A5_Stratigraphic_Modification_Event ;
    rdfs:label "TaphonomicProcess"@en ;
    rdfs:comment "Natural process altering position, condition, or integrity of an object since deposition"@en .

arqo:TaphonomicAlterationEvent a owl:Class ;
    rdfs:subClassOf crmarchaeo:A5_Stratigraphic_Modification_Event ;
    rdfs:label "TaphonomicAlterationEvent"@en ;
    rdfs:comment "Specific taphonomic event altering an object's state"@en .

arqo:FragmentationEvent a owl:Class ;
    rdfs:subClassOf crm:E81_Transformation ;
    rdfs:label "FragmentationEvent"@en ;
    rdfs:comment "Process producing fragments from an originally complete object"@en .

arqo:GeomorphologicalEvent a owl:Class ;
    rdfs:subClassOf crm:E5_Event ;
    rdfs:label "GeomorphologicalEvent"@en ;
    rdfs:comment "Natural geomorphological event affecting depositional context"@en .

arqo:PostDepositionalDisplacement a owl:Class ;
    rdfs:subClassOf crm:E9_Move ;
    rdfs:label "PostDepositionalDisplacement"@en ;
    rdfs:comment "Movement of an object from its primary depositional context"@en .

arqo:FragmentationState a owl:Class ;
    rdfs:subClassOf crm:E3_Condition_State ;
    rdfs:label "FragmentationState"@en ;
    rdfs:comment "Physical state where an object exists as multiple disconnected fragments"@en .

arqo:PatinaState a owl:Class ;
    rdfs:subClassOf crm:E3_Condition_State ;
    rdfs:label "PatinaState"@en ;
    rdfs:comment "Surface alteration connoting age, valued culturally as authenticity evidence"@en .

arqo:CorrosionState a owl:Class ;
    rdfs:subClassOf crm:E3_Condition_State ;
    rdfs:label "CorrosionState"@en ;
    rdfs:comment "Chemical degradation state of metallic objects"@en .

arqo:WeatheringState a owl:Class ;
    rdfs:subClassOf crm:E3_Condition_State ;
    rdfs:label "WeatheringState"@en ;
    rdfs:comment "Physical degradation from environmental exposure"@en .

arqo:IntegrityState a owl:Class ;
    rdfs:subClassOf crm:E3_Condition_State ;
    rdfs:label "IntegrityState"@en ;
    rdfs:comment "Degree of physical completeness of an object"@en .

arqo:DisplacedState a owl:Class ;
    rdfs:subClassOf crm:E3_Condition_State ;
    rdfs:label "DisplacedState"@en ;
    rdfs:comment "State of an object that has been moved from its primary depositional context"@en .

arqo:underwentTaphonomicProcess a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:TaphonomicProcess ;
    rdfs:label "underwentTaphonomicProcess"@en .

arqo:underwentFragmentation a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:FragmentationEvent ;
    rdfs:label "underwentFragmentation"@en .

arqo:affectedByGeomorphologicalEvent a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:GeomorphologicalEvent ;
    rdfs:label "affectedByGeomorphologicalEvent"@en .

arqo:wasDisplacedBy a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:PostDepositionalDisplacement ;
    rdfs:label "wasDisplacedBy"@en .

arqo:hasFragmentationState a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:FragmentationState ;
    rdfs:label "hasFragmentationState"@en .

arqo:hasPatinaState a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:PatinaState ;
    rdfs:label "hasPatinaState"@en .

arqo:hasCorrosionState a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:CorrosionState ;
    rdfs:label "hasCorrosionState"@en .

arqo:hasWeatheringState a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:WeatheringState ;
    rdfs:label "hasWeatheringState"@en .

arqo:hasIntegrityState a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:IntegrityState ;
    rdfs:label "hasIntegrityState"@en .

arqo:hasDisplacedState a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:DisplacedState ;
    rdfs:label "hasDisplacedState"@en .

arqo:isFragmentedInto a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:ArchaeologicalObject ;
    rdfs:label "isFragmentedInto"@en .

arqo:hasTaphonomicProcessType a owl:DatatypeProperty ;
    rdfs:domain arqo:TaphonomicProcess ;
    rdfs:range xsd:string ;
    rdfs:label "hasTaphonomicProcessType"@en .

arqo:hasFragmentationCause a owl:DatatypeProperty ;
    rdfs:domain arqo:FragmentationEvent ;
    rdfs:range xsd:string ;
    rdfs:label "hasFragmentationCause"@en .

arqo:hasGeomorphologicalProcessType a owl:DatatypeProperty ;
    rdfs:domain arqo:GeomorphologicalEvent ;
    rdfs:range xsd:string ;
    rdfs:label "hasGeomorphologicalProcessType"@en .

arqo:hasDisplacementDistance a owl:DatatypeProperty ;
    rdfs:domain arqo:PostDepositionalDisplacement ;
    rdfs:range xsd:decimal ;
    rdfs:label "hasDisplacementDistance"@en .

arqo:hasConservationState a owl:DatatypeProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range xsd:string ;
    rdfs:label "hasConservationState"@en .

arqo:hasPreservationRating a owl:DatatypeProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range xsd:decimal ;
    rdfs:label "hasPreservationRating"@en .

# ===================== RESTRICTIONS =======================
arqo:HumanMadeObject rdfs:subClassOf [
    rdf:type owl:Restriction ; owl:onProperty arqo:wasProducedBy ;
    owl:someValuesFrom arqo:ManufacturingEvent ] .

arqo:ArchaeologicalObject rdfs:subClassOf [
    rdf:type owl:Restriction ; owl:onProperty arqo:hasBiography ;
    owl:someValuesFrom arqo:ObjectBiography ] .
