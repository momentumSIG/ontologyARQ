# ============================================================
# Ontology: Archaeological Object Module
# Strategy: ontogenia | Step: 9/30
# CQ: CQ-OBJ-09
# ============================================================
# CQ-OBJ-09: Which excavation process units recovered a given
# archaeological object, and what documentation, observation,
# and material preservation events were associated with that
# recovery?
# ============================================================

@prefix arqo: <http://www.ontologyARQ.org/archaeological-object/> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix crmarchaeo: <http://www.cidoc-crm.org/crmarchaeo/> .
@prefix crmsci: <http://www.cidoc-crm.org/crmsci/> .
@prefix crminf: <http://www.cidoc-crm.org/crminf/> .
@prefix crmhs: <http://www.cidoc-crm.org/crmhs/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<http://www.ontologyARQ.org/archaeological-object/> a owl:Ontology ;
    rdfs:label "Archaeological Object Module"@en ;
    rdfs:comment "Ontology extension for archaeological objects compatible with CIDOC CRM v7.3.2 and CRMarchaeo v2.1.1"@en .

# ======================= CLASSES ===========================

arqo:ArchaeologicalObject a owl:Class ;
    rdfs:subClassOf crm:E19_Physical_Object ;
    rdfs:label "ArchaeologicalObject"@en ;
    rdfs:comment "Physical object recovered during archaeological investigation"@en .

arqo:ProcurementEvent a owl:Class ; rdfs:subClassOf crm:E9_Move ;
    rdfs:label "ProcurementEvent"@en ;
    rdfs:comment "Event of raw material extraction, acquisition, or collection that supplied geological or biological substances for object manufacture"@en .

arqo:RawMaterialSource a owl:Class ; rdfs:subClassOf crm:E53_Place ;
    rdfs:label "RawMaterialSource"@en ;
    rdfs:comment "Geological or geographic source of raw materials used in object manufacture"@en .

arqo:ReuseEvent a owl:Class ; rdfs:subClassOf crm:E7_Activity ;
    rdfs:label "ReuseEvent"@en ;
    rdfs:comment "Event in which an object is used again after its initial use phase, encompassing both lateral cycling and recycling"@en .

arqo:LateralCyclingEvent a owl:Class ; rdfs:subClassOf arqo:ReuseEvent ;
    rdfs:label "LateralCyclingEvent"@en ;
    rdfs:comment "Reuse of an object in a different social context without change of function"@en .

arqo:RecyclingEvent a owl:Class ; rdfs:subClassOf crm:E81_Transformation ;
    rdfs:label "RecyclingEvent"@en ;
    rdfs:comment "Event in which an object is re-entered into a manufacturing process"@en .

arqo:DiscardEvent a owl:Class ; rdfs:subClassOf crm:E5_Event ;
    rdfs:label "DiscardEvent"@en ;
    rdfs:comment "Event of object abandonment or discard that led to its entry into the archaeological record"@en .

arqo:PrimaryRefuse a owl:Class ; rdfs:subClassOf arqo:DiscardEvent ;
    rdfs:label "PrimaryRefuse"@en ;
    rdfs:comment "Discard event in which an object was abandoned at its place of use"@en .

arqo:SecondaryRefuse a owl:Class ; rdfs:subClassOf arqo:DiscardEvent ;
    rdfs:label "SecondaryRefuse"@en ;
    rdfs:comment "Discard event in which an object was transported to a designated refuse disposal area"@en .

arqo:DeFactoRefuse a owl:Class ; rdfs:subClassOf arqo:DiscardEvent ;
    rdfs:label "DeFactoRefuse"@en ;
    rdfs:comment "Abandonment of an object in situ without intentional discard"@en .

arqo:SocialPersona a owl:Class ; rdfs:subClassOf crm:E89_Propositional_Object ;
    rdfs:label "SocialPersona"@en ;
    rdfs:comment "A culturally attributed identity or social role assigned to an archaeological object at a given point in its biography"@en .

arqo:SocialPersonaTransition a owl:Class ; rdfs:subClassOf crm:E5_Event ;
    rdfs:label "SocialPersonaTransition"@en ;
    rdfs:comment "Event that marks the change of an object's social persona from one identity to another"@en .

arqo:ChaineOperatoire a owl:Class ; rdfs:subClassOf crm:E29_Design_or_Procedure ;
    rdfs:label "ChaineOperatoire"@en ;
    rdfs:comment "Complete ordered sequence of technical actions from raw material preparation to finished object"@en .

arqo:TechnicalAction a owl:Class ; rdfs:subClassOf crm:E7_Activity ;
    rdfs:label "TechnicalAction"@en ;
    rdfs:comment "Individual technical step within a chaîne opératoire"@en .

arqo:MaintenanceEvent a owl:Class ; rdfs:subClassOf crm:E11_Modification ;
    rdfs:label "MaintenanceEvent"@en ;
    rdfs:comment "Event of preventive care, minor repair, surface treatment, or functional adjustment performed during active use-life"@en .

arqo:CraftTradition a owl:Class ; rdfs:subClassOf crm:E74_Group ;
    rdfs:label "CraftTradition"@en ;
    rdfs:comment "A community of practice sharing technical knowledge, manufacturing procedures, and stylistic conventions"@en .

arqo:CulturalCommunity a owl:Class ; rdfs:subClassOf crm:E74_Group ;
    rdfs:label "CulturalCommunity"@en ;
    rdfs:comment "A social group sharing cultural practices, beliefs, and material culture traditions"@en .

arqo:DepositionEvent a owl:Class ; rdfs:subClassOf crmarchaeo:A4_Stratigraphic_Genesis ;
    rdfs:label "DepositionEvent"@en ;
    rdfs:comment "Event that placed an archaeological object into the stratigraphic record"@en .

arqo:IntentionalBurial a owl:Class ; rdfs:subClassOf arqo:DepositionEvent ;
    rdfs:label "IntentionalBurial"@en ;
    rdfs:comment "Deposition event involving deliberate burial of an object"@en .

arqo:EmergencyCaching a owl:Class ; rdfs:subClassOf arqo:DepositionEvent ;
    rdfs:label "EmergencyCaching"@en ;
    rdfs:comment "Deposition event involving hasty concealment of valuables in response to imminent threat"@en .

arqo:RitualOffering a owl:Class ; rdfs:subClassOf arqo:DepositionEvent ;
    rdfs:label "RitualOffering"@en ;
    rdfs:comment "Deposition event involving deliberate placement of an object as a votive or ritual offering"@en .

arqo:CasualAbandonment a owl:Class ; rdfs:subClassOf arqo:DepositionEvent ;
    rdfs:label "CasualAbandonment"@en ;
    rdfs:comment "Deposition event involving unstructured loss or abandonment without specific ritual or emergency motivation"@en .

# --- New in Step 9 (CQ-OBJ-09) ---

arqo:RecoveryEvent a owl:Class ;
    rdfs:subClassOf crmarchaeo:A1_Excavation_Process_Unit ;
    rdfs:label "RecoveryEvent"@en ;
    rdfs:comment "Excavation process unit through which an archaeological object was physically recovered from the stratigraphic record, including associated documentation and observation"@en .

arqo:RecoveryDocumentation a owl:Class ;
    rdfs:subClassOf crm:E31_Document ;
    rdfs:label "RecoveryDocumentation"@en ;
    rdfs:comment "Documentation produced during the recovery of an archaeological object, including field records, photographs, drawings, and contextual data"@en .

arqo:RecoveryObservation a owl:Class ;
    rdfs:subClassOf crmsci:S4_Observation ;
    rdfs:label "RecoveryObservation"@en ;
    rdfs:comment "Observation made during the recovery of an archaeological object, recording its in-situ condition, position, and associations"@en .

# =================== OBJECT PROPERTIES =====================

arqo:wasProcuredBy a owl:ObjectProperty ; rdfs:domain arqo:ArchaeologicalObject ; rdfs:range arqo:ProcurementEvent ;
    rdfs:label "wasProcuredBy"@en ; rdfs:comment "Links an object to the procurement event that supplied its raw materials"@en .

arqo:derivesFromSource a owl:ObjectProperty ; rdfs:domain arqo:ArchaeologicalObject ; rdfs:range arqo:RawMaterialSource ;
    rdfs:label "derivesFromSource"@en ; rdfs:comment "Links an object to the geological or biological source of its raw materials"@en .

arqo:procurementOccurredAt a owl:ObjectProperty ; rdfs:domain arqo:ProcurementEvent ; rdfs:range arqo:RawMaterialSource ;
    rdfs:label "procurementOccurredAt"@en ; rdfs:comment "Links a procurement event to the source location"@en .

arqo:wasSubjectToReuse a owl:ObjectProperty ; rdfs:domain arqo:ArchaeologicalObject ; rdfs:range arqo:ReuseEvent ;
    rdfs:label "wasSubjectToReuse"@en ; rdfs:comment "Links an object to a reuse event in its biography"@en .

arqo:wasLateralCycled a owl:ObjectProperty ; rdfs:domain arqo:ArchaeologicalObject ; rdfs:range arqo:LateralCyclingEvent ;
    rdfs:label "wasLateralCycled"@en ; rdfs:comment "Links an object to a lateral cycling event"@en .

arqo:wasRecycled a owl:ObjectProperty ; rdfs:domain arqo:ArchaeologicalObject ; rdfs:range arqo:RecyclingEvent ;
    rdfs:label "wasRecycled"@en ; rdfs:comment "Links an object to a recycling event"@en .

arqo:recyclingProducedObject a owl:ObjectProperty ; rdfs:domain arqo:RecyclingEvent ; rdfs:range arqo:ArchaeologicalObject ;
    rdfs:label "recyclingProducedObject"@en ; rdfs:comment "Links a recycling event to the new object produced"@en .

arqo:wasDiscardedBy a owl:ObjectProperty ; rdfs:domain arqo:ArchaeologicalObject ; rdfs:range arqo:DiscardEvent ;
    rdfs:label "wasDiscardedBy"@en ; rdfs:comment "Links an object to the discard event"@en .

arqo:discardOccurredAt a owl:ObjectProperty ; rdfs:domain arqo:DiscardEvent ; rdfs:range crm:E53_Place ;
    rdfs:label "discardOccurredAt"@en ; rdfs:comment "Links a discard event to the place of discard"@en .

arqo:discardMovedTo a owl:ObjectProperty ; rdfs:domain arqo:SecondaryRefuse ; rdfs:range crm:E53_Place ;
    rdfs:label "discardMovedTo"@en ; rdfs:comment "Links a secondary refuse event to the disposal area"@en .

arqo:hasSocialPersona a owl:ObjectProperty ; rdfs:domain arqo:ArchaeologicalObject ; rdfs:range arqo:SocialPersona ;
    rdfs:label "hasSocialPersona"@en ; rdfs:comment "Links an object to a social persona held during its biography"@en .

arqo:transitionFromPersona a owl:ObjectProperty ; rdfs:domain arqo:SocialPersonaTransition ; rdfs:range arqo:SocialPersona ;
    rdfs:label "transitionFromPersona"@en ; rdfs:comment "Links a transition to the previous persona"@en .

arqo:transitionToPersona a owl:ObjectProperty ; rdfs:domain arqo:SocialPersonaTransition ; rdfs:range arqo:SocialPersona ;
    rdfs:label "transitionToPersona"@en ; rdfs:comment "Links a transition to the new persona"@en .

arqo:transitionTriggeredBy a owl:ObjectProperty ; rdfs:domain arqo:SocialPersonaTransition ; rdfs:range crm:E5_Event ;
    rdfs:label "transitionTriggeredBy"@en ; rdfs:comment "Links a transition to the triggering event"@en .

arqo:transitionAppliedTo a owl:ObjectProperty ; rdfs:domain arqo:SocialPersonaTransition ; rdfs:range arqo:ArchaeologicalObject ;
    rdfs:label "transitionAppliedTo"@en ; rdfs:comment "Links a transition to the affected object"@en .

arqo:hasChaineOperatoire a owl:ObjectProperty ; rdfs:domain arqo:ArchaeologicalObject ; rdfs:range arqo:ChaineOperatoire ;
    rdfs:label "hasChaineOperatoire"@en ; rdfs:comment "Links an object to its chaîne opératoire"@en .

arqo:comprisesTechnicalAction a owl:ObjectProperty ; rdfs:domain arqo:ChaineOperatoire ; rdfs:range arqo:TechnicalAction ;
    rdfs:label "comprisesTechnicalAction"@en ; rdfs:comment "Links a chaîne opératoire to its technical actions"@en .

arqo:actionPrecedes a owl:ObjectProperty , owl:TransitiveProperty ; rdfs:domain arqo:TechnicalAction ; rdfs:range arqo:TechnicalAction ;
    rdfs:label "actionPrecedes"@en ; rdfs:comment "Orders two technical actions in the production sequence"@en .

arqo:actionFollows a owl:ObjectProperty , owl:TransitiveProperty ; owl:inverseOf arqo:actionPrecedes ;
    rdfs:domain arqo:TechnicalAction ; rdfs:range arqo:TechnicalAction ;
    rdfs:label "actionFollows"@en ; rdfs:comment "Inverse of actionPrecedes"@en .

arqo:actionTransformsMaterial a owl:ObjectProperty ; rdfs:domain arqo:TechnicalAction ; rdfs:range crm:E57_Material ;
    rdfs:label "actionTransformsMaterial"@en ; rdfs:comment "Links a technical action to the material it transforms"@en .

arqo:wasMaintainedBy a owl:ObjectProperty ; rdfs:domain arqo:ArchaeologicalObject ; rdfs:range arqo:MaintenanceEvent ;
    rdfs:label "wasMaintainedBy"@en ; rdfs:comment "Links an object to a maintenance event"@en .

arqo:maintenanceModified a owl:ObjectProperty ; rdfs:domain arqo:MaintenanceEvent ; rdfs:range arqo:ArchaeologicalObject ;
    rdfs:label "maintenanceModified"@en ; rdfs:comment "Links a maintenance event to the modified object"@en .

arqo:associatedWithActor a owl:ObjectProperty ; rdfs:domain arqo:ArchaeologicalObject ; rdfs:range crm:E39_Actor ;
    rdfs:label "associatedWithActor"@en ; rdfs:comment "Links an object to a human actor"@en .

arqo:associatedWithGroup a owl:ObjectProperty ; rdfs:domain arqo:ArchaeologicalObject ; rdfs:range crm:E74_Group ;
    rdfs:label "associatedWithGroup"@en ; rdfs:comment "Links an object to a social group"@en .

arqo:associatedWithCraftTradition a owl:ObjectProperty ; rdfs:domain arqo:ArchaeologicalObject ; rdfs:range arqo:CraftTradition ;
    rdfs:label "associatedWithCraftTradition"@en ; rdfs:comment "Links an object to its craft tradition"@en .

arqo:eventCarriedOutBy a owl:ObjectProperty ; rdfs:domain crm:E5_Event ; rdfs:range crm:E39_Actor ;
    rdfs:label "eventCarriedOutBy"@en ; rdfs:comment "Links an event to the actor who carried it out"@en .

arqo:craftTraditionBelongsToCommunity a owl:ObjectProperty ; rdfs:domain arqo:CraftTradition ; rdfs:range arqo:CulturalCommunity ;
    rdfs:label "craftTraditionBelongsToCommunity"@en ; rdfs:comment "Links a craft tradition to its cultural community"@en .

arqo:wasDepositedBy a owl:ObjectProperty ; rdfs:domain arqo:ArchaeologicalObject ; rdfs:range arqo:DepositionEvent ;
    rdfs:label "wasDepositedBy"@en ; rdfs:comment "Links an object to its deposition event"@en .

arqo:depositedIntoUnit a owl:ObjectProperty ; rdfs:domain arqo:DepositionEvent ; rdfs:range crmarchaeo:A8_Stratigraphic_Unit ;
    rdfs:label "depositedIntoUnit"@en ; rdfs:comment "Links a deposition event to the stratigraphic unit"@en .

# --- New in Step 9 (CQ-OBJ-09) ---

arqo:wasRecoveredBy a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:RecoveryEvent ;
    rdfs:label "wasRecoveredBy"@en ;
    rdfs:comment "Links an object to the excavation process unit that recovered it from the stratigraphic record"@en .

arqo:recoveryProducedDocumentation a owl:ObjectProperty ;
    rdfs:domain arqo:RecoveryEvent ;
    rdfs:range arqo:RecoveryDocumentation ;
    rdfs:label "recoveryProducedDocumentation"@en ;
    rdfs:comment "Links a recovery event to the documentation it produced"@en .

arqo:recoveryIncludedObservation a owl:ObjectProperty ;
    rdfs:domain arqo:RecoveryEvent ;
    rdfs:range arqo:RecoveryObservation ;
    rdfs:label "recoveryIncludedObservation"@en ;
    rdfs:comment "Links a recovery event to observations made during the recovery"@en .

arqo:recoveryExcavatedFrom a owl:ObjectProperty ;
    rdfs:domain arqo:RecoveryEvent ;
    rdfs:range crmarchaeo:A8_Stratigraphic_Unit ;
    rdfs:label "recoveryExcavatedFrom"@en ;
    rdfs:comment "Links a recovery event to the stratigraphic unit from which the object was excavated"@en .

# ==================== DATA PROPERTIES =====================

arqo:hasProcurementType a owl:DatatypeProperty ; rdfs:domain arqo:ProcurementEvent ; rdfs:range xsd:string ;
    rdfs:label "hasProcurementType"@en ; rdfs:comment "Type of procurement"@en .

arqo:hasRawMaterialProvenance a owl:DatatypeProperty ; rdfs:domain arqo:ArchaeologicalObject ; rdfs:range xsd:string ;
    rdfs:label "hasRawMaterialProvenance"@en ; rdfs:comment "Provenance of raw materials"@en .

arqo:hasReuseContext a owl:DatatypeProperty ; rdfs:domain arqo:LateralCyclingEvent ; rdfs:range xsd:string ;
    rdfs:label "hasReuseContext"@en ; rdfs:comment "Social context of lateral cycling"@en .

arqo:hasDiscardIntentionality a owl:DatatypeProperty ; rdfs:domain arqo:DiscardEvent ; rdfs:range xsd:string ;
    rdfs:label "hasDiscardIntentionality"@en ; rdfs:comment "Behavioral motivation behind discard"@en .

arqo:hasPersonaLabel a owl:DatatypeProperty ; rdfs:domain arqo:SocialPersona ; rdfs:range xsd:string ;
    rdfs:label "hasPersonaLabel"@en ; rdfs:comment "Label for the social persona"@en .

arqo:hasActionSequenceOrder a owl:DatatypeProperty ; rdfs:domain arqo:TechnicalAction ; rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "hasActionSequenceOrder"@en ; rdfs:comment "Position in the chaîne opératoire"@en .

arqo:hasActionDescription a owl:DatatypeProperty ; rdfs:domain arqo:TechnicalAction ; rdfs:range xsd:string ;
    rdfs:label "hasActionDescription"@en ; rdfs:comment "Description of the technical action"@en .

arqo:hasManufacturingTradition a owl:DatatypeProperty ; rdfs:domain arqo:ChaineOperatoire ; rdfs:range xsd:string ;
    rdfs:label "hasManufacturingTradition"@en ; rdfs:comment "Manufacturing tradition name"@en .

arqo:hasMaintenanceType a owl:DatatypeProperty ; rdfs:domain arqo:MaintenanceEvent ; rdfs:range xsd:string ;
    rdfs:label "hasMaintenanceType"@en ; rdfs:comment "Type of maintenance"@en .

arqo:hasMaintenanceDescription a owl:DatatypeProperty ; rdfs:domain arqo:MaintenanceEvent ; rdfs:range xsd:string ;
    rdfs:label "hasMaintenanceDescription"@en ; rdfs:comment "Description of maintenance"@en .

arqo:hasDepositionMotivation a owl:DatatypeProperty ; rdfs:domain arqo:DepositionEvent ; rdfs:range xsd:string ;
    rdfs:label "hasDepositionMotivation"@en ; rdfs:comment "Behavioral motivation behind deposition"@en .

arqo:hasDepositionDate a owl:DatatypeProperty ; rdfs:domain arqo:DepositionEvent ; rdfs:range xsd:string ;
    rdfs:label "hasDepositionDate"@en ; rdfs:comment "Date of deposition"@en .

# --- New in Step 9 (CQ-OBJ-09) ---

arqo:hasRecoveryDate a owl:DatatypeProperty ;
    rdfs:domain arqo:RecoveryEvent ;
    rdfs:range xsd:string ;
    rdfs:label "hasRecoveryDate"@en ;
    rdfs:comment "Date on which the object was recovered during excavation"@en .

arqo:hasRecoveryMethod a owl:DatatypeProperty ;
    rdfs:domain arqo:RecoveryEvent ;
    rdfs:range xsd:string ;
    rdfs:label "hasRecoveryMethod"@en ;
    rdfs:comment "Method of recovery employed during excavation (e.g., dry sieving, flotation, hand collection)"@en .

# ===================== RESTRICTIONS =======================

arqo:ProcurementEvent rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty arqo:procurementOccurredAt ; owl:someValuesFrom arqo:RawMaterialSource ] .
arqo:LateralCyclingEvent rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty crm:P12_occurred_in_the_presence_of ; owl:someValuesFrom arqo:ArchaeologicalObject ] .
arqo:RecyclingEvent rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty arqo:recyclingProducedObject ; owl:someValuesFrom arqo:ArchaeologicalObject ] .
arqo:DiscardEvent rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty arqo:discardOccurredAt ; owl:someValuesFrom crm:E53_Place ] .
arqo:SecondaryRefuse rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty arqo:discardMovedTo ; owl:someValuesFrom crm:E53_Place ] .
arqo:SocialPersonaTransition rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty arqo:transitionFromPersona ; owl:someValuesFrom arqo:SocialPersona ] .
arqo:SocialPersonaTransition rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty arqo:transitionToPersona ; owl:someValuesFrom arqo:SocialPersona ] .
arqo:SocialPersonaTransition rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty arqo:transitionAppliedTo ; owl:someValuesFrom arqo:ArchaeologicalObject ] .
arqo:ChaineOperatoire rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty arqo:comprisesTechnicalAction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
arqo:TechnicalAction rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty arqo:hasActionSequenceOrder ; owl:cardinality "1"^^xsd:nonNegativeInteger ] .
arqo:MaintenanceEvent rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty arqo:maintenanceModified ; owl:someValuesFrom arqo:ArchaeologicalObject ] .
arqo:DepositionEvent rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty arqo:depositedIntoUnit ; owl:someValuesFrom crmarchaeo:A8_Stratigraphic_Unit ] .

# --- New in Step 9 (CQ-OBJ-09) ---

arqo:RecoveryEvent rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty arqo:recoveryExcavatedFrom ;
    owl:someValuesFrom crmarchaeo:A8_Stratigraphic_Unit
] .
