arqo:SocialPersonaTransition rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty arqo:transitionToPersona ; owl:someValuesFrom arqo:SocialPersona ] .
arqo:SocialPersonaTransition rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty arqo:transitionAppliedTo ; owl:someValuesFrom arqo:ArchaeologicalObject ] .
arqo:ChaineOperatoire rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty arqo:comprisesTechnicalAction ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
arqo:TechnicalAction rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty arqo:hasActionSequenceOrder ; owl:cardinality "1"^^xsd:nonNegativeInteger ] .
arqo:MaintenanceEvent rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty arqo:maintenanceModified ; owl:someValuesFrom arqo:ArchaeologicalObject ] .
arqo:DepositionEvent rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty arqo:depositedIntoUnit ; owl:someValuesFrom crmarchaeo:A8_Stratigraphic_Unit ] .
arqo:RecoveryEvent rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty arqo:recoveryExcavatedFrom ; owl:someValuesFrom crmarchaeo:A8_Stratigraphic_Unit ] .
arqo:ObjectBiography rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty arqo:biographyComprisesEvent ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
arqo:BiographicalParallelism rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty arqo:parallelBiographyOf ; owl:minCardinality "2"^^xsd:nonNegativeInteger ] .
arqo:InternalClockMeasurement rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty arqo:measurementSuggestsTimeSpan ; owl:someValuesFrom crm:E52_Time-Span ] .
arqo:ArchaeologicalObject rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty arqo:hasMaterialComponent ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
arqo:OntologicalShiftEvent rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty arqo:shiftedToMode ; owl:someValuesFrom arqo:ModeOfExperience ] .
arqo:OntologicalShiftEvent rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty arqo:shiftAppliedToObject ; owl:someValuesFrom arqo:ArchaeologicalObject ] .


