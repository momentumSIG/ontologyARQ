# ============================================================
# Ontology: Archaeological Object Module
# Strategy: ontogenia | Step: 25/30
# CQ: CQ-OBJ-25
# ============================================================
# CQ-OBJ-25: What archaeological archive records — field notebooks, digital databases, photographic archives, drawing collections, or published reports — document an archaeological object, and how do these records function as archaeological objects in their own right?
# ============================================================

# CQ-OBJ-24: To which compositional group (Leitlegierung) — defined by diagnostic elemental ratios or alloy signatures — has a metallic archaeological object been assigned, and what analytical technique produced the compositional data supporting this assignment?
# ============================================================

# CQ-OBJ-23: What is the strength of the typological-to-period relationship for an archaeological object — weak (the type appears in the period, AP29), moderate (the type is typical for the period, AP31), or strong (the type is restricted exclusively to the period, AP30)?
# ============================================================

# CQ-OBJ-22: Which significant features — diagnostically relevant attributes identified through systematic analysis — support the chronological or cultural assignment of an archaeological object, and how strong is the evidential link between each feature and the assigned period?
# ============================================================

# CQ-OBJ-21: Under which typological scheme — monothetic classification based on a single diagnostic attribute, or polythetic cluster analysis based on multiple attribute states — has an archaeological object been classified, and what criteria define the assigned type?
# ============================================================

# CQ-OBJ-20: What Munsell color values, surface texture descriptions, and visual appearance attributes does an archaeological object exhibit in its current state of preservation?
# ============================================================

# CQ-OBJ-19: What component parts — handles, lids, blades, shafts, inlays, or attachments — are physically assembled into a composite archaeological object, and what joining techniques connect them?
# ============================================================

# CQ-OBJ-18: What morphometric attributes — dimensions, weight, volume, surface area, and shape descriptors — characterize an archaeological object, and how do these attributes compare with the expected range for its assigned typological class?
# ============================================================

# CQ-OBJ-17: What is the fragmentation state of an archaeological object — complete, partially fragmented, or reduced to isolated sherds — and what proportion of the original object is preserved?
# ============================================================

# CQ-OBJ-16: What surface alterations — patina, corrosion layers, weathering rinds, use-wear polish, or oxidation films — are present on an archaeological object, and how do these alterations contribute to the culturally perceived quality of pastness?
# ============================================================

# CQ-OBJ-15: In which stratigraphic volume unit is an archaeological object embedded, and what is the stability and physical nature of that embedding relationship?
# ============================================================

# CQ-OBJ-14: In what refuse distribution state is an
# archaeological object — primary refuse (at place of use),
# secondary refuse (transported to disposal area), or de facto
# refuse (abandoned in situ without intentional discard) — and
# what spatial evidence supports this classification?
# ============================================================

@prefix arqo: <http://www.ontologyARQ.org/archaeological-object/> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix crmarchaeo: <http://www.cidoc-crm.org/crmarchaeo/> .
@prefix crmsci: <http://www.cidoc-crm.org/crmsci/> .
@prefix crminf: <http://www.cidoc-crm.org/crminf/> .
@prefix crmhs: <http://www.cidoc-crm.org/crmhs/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<http://www.ontologyARQ.org/archaeological-object/> a owl:Ontology ;
    rdfs:label "Archaeological Object Module"@en ;
    rdfs:comment "Ontology extension for archaeological objects compatible with CIDOC CRM v7.3.2 and CRMarchaeo v2.1.1"@en .

# ======================= CLASSES ===========================

arqo:ArchaeologicalObject a owl:Class ; rdfs:subClassOf crm:E19_Physical_Object ;
    rdfs:label "ArchaeologicalObject"@en ; rdfs:comment "Physical object recovered during archaeological investigation"@en .
arqo:ProcurementEvent a owl:Class ; rdfs:subClassOf crm:E9_Move ;
    rdfs:label "ProcurementEvent"@en ; rdfs:comment "Event of raw material extraction, acquisition, or collection"@en .
arqo:RawMaterialSource a owl:Class ; rdfs:subClassOf crm:E53_Place ;
    rdfs:label "RawMaterialSource"@en ; rdfs:comment "Geological or geographic source of raw materials"@en .
arqo:ReuseEvent a owl:Class ; rdfs:subClassOf crm:E7_Activity ;
    rdfs:label "ReuseEvent"@en ; rdfs:comment "Event of object reuse after initial use phase"@en .
arqo:LateralCyclingEvent a owl:Class ; rdfs:subClassOf arqo:ReuseEvent ;
    rdfs:label "LateralCyclingEvent"@en ; rdfs:comment "Reuse in different social context without function change"@en .
arqo:RecyclingEvent a owl:Class ; rdfs:subClassOf crm:E81_Transformation ;
    rdfs:label "RecyclingEvent"@en ; rdfs:comment "Re-entry into manufacturing process"@en .
arqo:DiscardEvent a owl:Class ; rdfs:subClassOf crm:E5_Event ;
    rdfs:label "DiscardEvent"@en ; rdfs:comment "Event of discard leading to archaeological record entry"@en .
arqo:PrimaryRefuse a owl:Class ; rdfs:subClassOf arqo:DiscardEvent ;
    rdfs:label "PrimaryRefuse"@en ; rdfs:comment "Discard at place of use"@en .
arqo:SecondaryRefuse a owl:Class ; rdfs:subClassOf arqo:DiscardEvent ;
    rdfs:label "SecondaryRefuse"@en ; rdfs:comment "Discard transported to refuse area"@en .
arqo:DeFactoRefuse a owl:Class ; rdfs:subClassOf arqo:DiscardEvent ;
    rdfs:label "DeFactoRefuse"@en ; rdfs:comment "Abandonment without intentional discard"@en .
arqo:SocialPersona a owl:Class ; rdfs:subClassOf crm:E89_Propositional_Object ;
    rdfs:label "SocialPersona"@en ; rdfs:comment "Culturally attributed identity of an object"@en .
arqo:SocialPersonaTransition a owl:Class ; rdfs:subClassOf crm:E5_Event ;
    rdfs:label "SocialPersonaTransition"@en ; rdfs:comment "Change of object social persona"@en .
arqo:ChaineOperatoire a owl:Class ; rdfs:subClassOf crm:E29_Design_or_Procedure ;
    rdfs:label "ChaineOperatoire"@en ; rdfs:comment "Complete ordered sequence of technical actions"@en .
arqo:TechnicalAction a owl:Class ; rdfs:subClassOf crm:E7_Activity ;
    rdfs:label "TechnicalAction"@en ; rdfs:comment "Individual step within a chaîne opératoire"@en .
arqo:MaintenanceEvent a owl:Class ; rdfs:subClassOf crm:E11_Modification ;
    rdfs:label "MaintenanceEvent"@en ; rdfs:comment "Preventive care or repair during active use-life"@en .
arqo:CraftTradition a owl:Class ; rdfs:subClassOf crm:E74_Group ;
    rdfs:label "CraftTradition"@en ; rdfs:comment "Community of practice sharing technical knowledge"@en .
arqo:CulturalCommunity a owl:Class ; rdfs:subClassOf crm:E74_Group ;
    rdfs:label "CulturalCommunity"@en ; rdfs:comment "Social group sharing cultural practices and material traditions"@en .
arqo:DepositionEvent a owl:Class ; rdfs:subClassOf crmarchaeo:A4_Stratigraphic_Genesis ;
    rdfs:label "DepositionEvent"@en ; rdfs:comment "Event placing object into stratigraphic record"@en .
arqo:IntentionalBurial a owl:Class ; rdfs:subClassOf arqo:DepositionEvent ;
    rdfs:label "IntentionalBurial"@en ; rdfs:comment "Deliberate burial of an object"@en .
arqo:EmergencyCaching a owl:Class ; rdfs:subClassOf arqo:DepositionEvent ;
    rdfs:label "EmergencyCaching"@en ; rdfs:comment "Hasty concealment in response to threat"@en .
arqo:RitualOffering a owl:Class ; rdfs:subClassOf arqo:DepositionEvent ;
    rdfs:label "RitualOffering"@en ; rdfs:comment "Votive or ritual placement"@en .
arqo:CasualAbandonment a owl:Class ; rdfs:subClassOf arqo:DepositionEvent ;
    rdfs:label "CasualAbandonment"@en ; rdfs:comment "Unstructured loss or abandonment"@en .
arqo:RecoveryEvent a owl:Class ; rdfs:subClassOf crmarchaeo:A1_Excavation_Process_Unit ;
    rdfs:label "RecoveryEvent"@en ; rdfs:comment "Excavation unit that recovered the object"@en .
arqo:RecoveryDocumentation a owl:Class ; rdfs:subClassOf crm:E31_Document ;
    rdfs:label "RecoveryDocumentation"@en ; rdfs:comment "Documentation produced during recovery"@en .
arqo:RecoveryObservation a owl:Class ; rdfs:subClassOf crmsci:S4_Observation ;
    rdfs:label "RecoveryObservation"@en ; rdfs:comment "Observation during recovery"@en .
arqo:ObjectBiography a owl:Class ; rdfs:subClassOf crm:E5_Event ;
    rdfs:label "ObjectBiography"@en ; rdfs:comment "Ordered sequence of biographical events"@en .
arqo:BiographicalParallelism a owl:Class ; rdfs:subClassOf crminf:I4_Proposition_Set ;
    rdfs:label "BiographicalParallelism"@en ; rdfs:comment "Assertion that objects share similar biographical sequences"@en .
arqo:InternalClockIndicator a owl:Class ; rdfs:subClassOf crm:E26_Physical_Feature ;
    rdfs:label "InternalClockIndicator"@en ; rdfs:comment "Measurable physical-chemical property serving as age indicator"@en .
arqo:InternalClockMeasurement a owl:Class ; rdfs:subClassOf crmsci:S21_Measurement ;
    rdfs:label "InternalClockMeasurement"@en ; rdfs:comment "Scientific measurement of an internal clock indicator"@en .
arqo:MaterialComponent a owl:Class ; rdfs:subClassOf crm:E57_Material ;
    rdfs:label "MaterialComponent"@en ; rdfs:comment "Material constituent of an archaeological object"@en .
arqo:MaterialRelation a owl:Class ; rdfs:subClassOf crm:E1_CRM_Entity ;
    rdfs:label "MaterialRelation"@en ; rdfs:comment "Reified relationship between material components (Knappett)"@en .
arqo:ModeOfExperience a owl:Class ; rdfs:subClassOf crm:E3_Condition_State ;
    rdfs:label "ModeOfExperience"@en ; rdfs:comment "Heideggerian ontological mode: readiness-to-hand or presence-at-hand"@en .
arqo:ReadinessToHand a owl:Class ; rdfs:subClassOf arqo:ModeOfExperience ;
    rdfs:label "ReadinessToHand"@en ; rdfs:comment "Object experienced as available tool"@en .
arqo:PresenceAtHand a owl:Class ; rdfs:subClassOf arqo:ModeOfExperience ;
    rdfs:label "PresenceAtHand"@en ; rdfs:comment "Object experienced as detached specimen"@en .
arqo:OntologicalShiftEvent a owl:Class ; rdfs:subClassOf crm:E5_Event ;
    rdfs:label "OntologicalShiftEvent"@en ; rdfs:comment "Event causing transition between modes of experience"@en .

# --- New in Step 14 (CQ-OBJ-14) ---

arqo:RefuseDistributionState a owl:Class ;
    rdfs:subClassOf crm:E3_Condition_State ;
    rdfs:label "RefuseDistributionState"@en ;
    rdfs:comment "Spatial-distributional condition of an object in the archaeological record: primary refuse (at place of use), secondary refuse (transported to disposal area), or de facto refuse (abandoned in situ)"@en .


# --- New in Step 15 (CQ-OBJ-15) ---

arqo:EmbeddingRelation a owl:Class ;
    rdfs:subClassOf crmarchaeo:A7_Embedding ;
    rdfs:label "EmbeddingRelation"@en ;
    rdfs:comment "Physical containment of an archaeological object within a stratigraphic volume unit with relative stability, following the CRMarchaeo embedding pattern (E18 - AP18i - A7 - AP19 - A2)"@en .


# --- New in Step 16 (CQ-OBJ-16) ---

arqo:SurfaceAlteration a owl:Class ;
    rdfs:subClassOf crm:E26_Physical_Feature ;
    rdfs:label "SurfaceAlteration"@en ;
    rdfs:comment "Physical modification of an object's surface including patina, corrosion layers, weathering rinds, use-wear polish, and oxidation films"@en .

arqo:PastnessQuality a owl:Class ;
    rdfs:subClassOf crm:E1_CRM_Entity ;
    rdfs:label "PastnessQuality"@en ;
    rdfs:comment "Culturally constructed experiential quality of being 'from the past' that emerges from material traces of disintegration on an object's surface"@en .


# --- New in Step 17 (CQ-OBJ-17) ---

arqo:FragmentationState a owl:Class ;
    rdfs:subClassOf crm:E3_Condition_State ;
    rdfs:label "FragmentationState"@en ;
    rdfs:comment "Physical state of an object regarding its completeness: complete, partially fragmented, or reduced to isolated fragments"@en .


# --- New in Step 18 (CQ-OBJ-18) ---

arqo:MorphometricAttribute a owl:Class ;
    rdfs:subClassOf crmsci:S21_Measurement ;
    rdfs:label "MorphometricAttribute"@en ;
    rdfs:comment "Quantitative physical measurement of an archaeological object including dimensions, weight, volume, surface area, and shape descriptors"@en .


# --- New in Step 19 (CQ-OBJ-19) ---

arqo:ComponentPart a owl:Class ;
    rdfs:subClassOf crm:E19_Physical_Object ;
    rdfs:label "ComponentPart"@en ;
    rdfs:comment "Physical component of a composite archaeological object, such as a handle, lid, blade, shaft, inlay, or attachment"@en .

arqo:JoiningTechnique a owl:Class ;
    rdfs:subClassOf crm:E29_Design_or_Procedure ;
    rdfs:label "JoiningTechnique"@en ;
    rdfs:comment "Technical procedure used to connect component parts of a composite object, such as riveting, soldering, adhesion, mortise-and-tenon, or lashing"@en .


# --- New in Step 20 (CQ-OBJ-20) ---

arqo:VisualAppearanceAttribute a owl:Class ;
    rdfs:subClassOf crm:E26_Physical_Feature ;
    rdfs:label "VisualAppearanceAttribute"@en ;
    rdfs:comment "Observable visual property of an archaeological object in its current state of preservation, including Munsell color, surface texture, and general appearance"@en .


# --- New in Step 21 (CQ-OBJ-21) ---

arqo:TypologicalAssignment a owl:Class ;
    rdfs:subClassOf crm:E17_Type_Assignment ;
    rdfs:label "TypologicalAssignment"@en ;
    rdfs:comment "Researcher assignment of an object to a typological category, using either monothetic or polythetic classification methods"@en .

arqo:ClassificationMethod a owl:Class ;
    rdfs:subClassOf crm:E29_Design_or_Procedure ;
    rdfs:label "ClassificationMethod"@en ;
    rdfs:comment "Method employed for typological classification: monothetic (single diagnostic attribute) or polythetic (cluster analysis of multiple attributes)"@en .


# --- New in Step 22 (CQ-OBJ-22) ---

arqo:SignificantFeature a owl:Class ;
    rdfs:subClassOf crm:E26_Physical_Feature ;
    rdfs:label "SignificantFeature"@en ;
    rdfs:comment "Diagnostically relevant physical attribute of an object identified through systematic analysis that supports chronological or cultural assignment"@en .

arqo:FeatureEvidenceLink a owl:Class ;
    rdfs:subClassOf crm:E1_CRM_Entity ;
    rdfs:label "FeatureEvidenceLink"@en ;
    rdfs:comment "Reified evidential link between a significant feature and the chronological or cultural period it supports, with explicit strength assessment"@en .


# --- New in Step 23 (CQ-OBJ-23) ---

arqo:TypeToPeriodRelationship a owl:Class ;
    rdfs:subClassOf crm:E1_CRM_Entity ;
    rdfs:label "TypeToPeriodRelationship"@en ;
    rdfs:comment "Reified relationship between a typological type and a chronological period, with explicit strength level following CRMarchaeo AP29 (weak), AP31 (moderate), AP30 (strong)"@en .


# --- New in Step 24 (CQ-OBJ-24) ---

arqo:CompositionalGroupAssignment a owl:Class ;
    rdfs:subClassOf crm:E17_Type_Assignment ;
    rdfs:label "CompositionalGroupAssignment"@en ;
    rdfs:comment "Assignment of a metallic object to a compositional group (Leitlegierung) defined by diagnostic elemental ratios or alloy signatures"@en .

arqo:CompositionalGroup a owl:Class ;
    rdfs:subClassOf crm:E55_Type ;
    rdfs:label "CompositionalGroup"@en ;
    rdfs:comment "Group of metallic objects sharing characteristic elemental ratios or alloy signatures (Leitlegierung)"@en .


# --- New in Step 25 (CQ-OBJ-25) ---

arqo:ArchaeologicalArchiveRecord a owl:Class ;
    rdfs:subClassOf crm:E73_Information_Object ;
    rdfs:label "ArchaeologicalArchiveRecord"@en ;
    rdfs:comment "Record within the archaeological archive documenting an object: field notebooks, digital databases, photographic archives, drawing collections, or published reports. Archive records function as archaeological objects in their own right."@en .

arqo:ArchiveCollection a owl:Class ;
    rdfs:subClassOf crm:E78_Curated_Holding ;
    rdfs:label "ArchiveCollection"@en ;
    rdfs:comment "Curated collection of archaeological archive records maintained by a research institution"@en .

# =================== OBJECT PROPERTIES =====================

arqo:wasProcuredBy a owl:ObjectProperty ; rdfs:domain arqo:ArchaeologicalObject ; rdfs:range arqo:ProcurementEvent ; rdfs:label "wasProcuredBy"@en ; rdfs:comment "Links object to procurement event"@en .
arqo:derivesFromSource a owl:ObjectProperty ; rdfs:domain arqo:ArchaeologicalObject ; rdfs:range arqo:RawMaterialSource ; rdfs:label "derivesFromSource"@en ; rdfs:comment "Links object to raw material source"@en .
arqo:procurementOccurredAt a owl:ObjectProperty ; rdfs:domain arqo:ProcurementEvent ; rdfs:range arqo:RawMaterialSource ; rdfs:label "procurementOccurredAt"@en ; rdfs:comment "Links procurement to source location"@en .
arqo:wasSubjectToReuse a owl:ObjectProperty ; rdfs:domain arqo:ArchaeologicalObject ; rdfs:range arqo:ReuseEvent ; rdfs:label "wasSubjectToReuse"@en ; rdfs:comment "Links object to reuse event"@en .
arqo:wasLateralCycled a owl:ObjectProperty ; rdfs:domain arqo:ArchaeologicalObject ; rdfs:range arqo:LateralCyclingEvent ; rdfs:label "wasLateralCycled"@en ; rdfs:comment "Links object to lateral cycling"@en .
arqo:wasRecycled a owl:ObjectProperty ; rdfs:domain arqo:ArchaeologicalObject ; rdfs:range arqo:RecyclingEvent ; rdfs:label "wasRecycled"@en ; rdfs:comment "Links object to recycling"@en .
arqo:recyclingProducedObject a owl:ObjectProperty ; rdfs:domain arqo:RecyclingEvent ; rdfs:range arqo:ArchaeologicalObject ; rdfs:label "recyclingProducedObject"@en ; rdfs:comment "Links recycling to new object"@en .
arqo:wasDiscardedBy a owl:ObjectProperty ; rdfs:domain arqo:ArchaeologicalObject ; rdfs:range arqo:DiscardEvent ; rdfs:label "wasDiscardedBy"@en ; rdfs:comment "Links object to discard event"@en .
arqo:discardOccurredAt a owl:ObjectProperty ; rdfs:domain arqo:DiscardEvent ; rdfs:range crm:E53_Place ; rdfs:label "discardOccurredAt"@en ; rdfs:comment "Links discard to place"@en .
arqo:discardMovedTo a owl:ObjectProperty ; rdfs:domain arqo:SecondaryRefuse ; rdfs:range crm:E53_Place ; rdfs:label "discardMovedTo"@en ; rdfs:comment "Links secondary refuse to disposal area"@en .
arqo:hasSocialPersona a owl:ObjectProperty ; rdfs:domain arqo:ArchaeologicalObject ; rdfs:range arqo:SocialPersona ; rdfs:label "hasSocialPersona"@en ; rdfs:comment "Links object to social persona"@en .
arqo:transitionFromPersona a owl:ObjectProperty ; rdfs:domain arqo:SocialPersonaTransition ; rdfs:range arqo:SocialPersona ; rdfs:label "transitionFromPersona"@en ; rdfs:comment "Previous persona in transition"@en .
arqo:transitionToPersona a owl:ObjectProperty ; rdfs:domain arqo:SocialPersonaTransition ; rdfs:range arqo:SocialPersona ; rdfs:label "transitionToPersona"@en ; rdfs:comment "New persona in transition"@en .
arqo:transitionTriggeredBy a owl:ObjectProperty ; rdfs:domain arqo:SocialPersonaTransition ; rdfs:range crm:E5_Event ; rdfs:label "transitionTriggeredBy"@en ; rdfs:comment "Event triggering persona change"@en .
arqo:transitionAppliedTo a owl:ObjectProperty ; rdfs:domain arqo:SocialPersonaTransition ; rdfs:range arqo:ArchaeologicalObject ; rdfs:label "transitionAppliedTo"@en ; rdfs:comment "Object affected by persona transition"@en .
arqo:hasChaineOperatoire a owl:ObjectProperty ; rdfs:domain arqo:ArchaeologicalObject ; rdfs:range arqo:ChaineOperatoire ; rdfs:label "hasChaineOperatoire"@en ; rdfs:comment "Links object to chaîne opératoire"@en .
arqo:comprisesTechnicalAction a owl:ObjectProperty ; rdfs:domain arqo:ChaineOperatoire ; rdfs:range arqo:TechnicalAction ; rdfs:label "comprisesTechnicalAction"@en ; rdfs:comment "Links chaîne to technical actions"@en .
arqo:actionPrecedes a owl:ObjectProperty , owl:TransitiveProperty ; rdfs:domain arqo:TechnicalAction ; rdfs:range arqo:TechnicalAction ; rdfs:label "actionPrecedes"@en ; rdfs:comment "Orders actions in sequence"@en .
arqo:actionFollows a owl:ObjectProperty , owl:TransitiveProperty ; owl:inverseOf arqo:actionPrecedes ; rdfs:domain arqo:TechnicalAction ; rdfs:range arqo:TechnicalAction ; rdfs:label "actionFollows"@en ; rdfs:comment "Inverse of actionPrecedes"@en .
arqo:actionTransformsMaterial a owl:ObjectProperty ; rdfs:domain arqo:TechnicalAction ; rdfs:range crm:E57_Material ; rdfs:label "actionTransformsMaterial"@en ; rdfs:comment "Links action to material transformed"@en .
arqo:wasMaintainedBy a owl:ObjectProperty ; rdfs:domain arqo:ArchaeologicalObject ; rdfs:range arqo:MaintenanceEvent ; rdfs:label "wasMaintainedBy"@en ; rdfs:comment "Links object to maintenance event"@en .
arqo:maintenanceModified a owl:ObjectProperty ; rdfs:domain arqo:MaintenanceEvent ; rdfs:range arqo:ArchaeologicalObject ; rdfs:label "maintenanceModified"@en ; rdfs:comment "Links maintenance to modified object"@en .
arqo:associatedWithActor a owl:ObjectProperty ; rdfs:domain arqo:ArchaeologicalObject ; rdfs:range crm:E39_Actor ; rdfs:label "associatedWithActor"@en ; rdfs:comment "Links object to human actor"@en .
arqo:associatedWithGroup a owl:ObjectProperty ; rdfs:domain arqo:ArchaeologicalObject ; rdfs:range crm:E74_Group ; rdfs:label "associatedWithGroup"@en ; rdfs:comment "Links object to social group"@en .
arqo:associatedWithCraftTradition a owl:ObjectProperty ; rdfs:domain arqo:ArchaeologicalObject ; rdfs:range arqo:CraftTradition ; rdfs:label "associatedWithCraftTradition"@en ; rdfs:comment "Links object to craft tradition"@en .
arqo:eventCarriedOutBy a owl:ObjectProperty ; rdfs:domain crm:E5_Event ; rdfs:range crm:E39_Actor ; rdfs:label "eventCarriedOutBy"@en ; rdfs:comment "Links event to carrying actor"@en .
arqo:craftTraditionBelongsToCommunity a owl:ObjectProperty ; rdfs:domain arqo:CraftTradition ; rdfs:range arqo:CulturalCommunity ; rdfs:label "craftTraditionBelongsToCommunity"@en ; rdfs:comment "Links tradition to community"@en .
arqo:wasDepositedBy a owl:ObjectProperty ; rdfs:domain arqo:ArchaeologicalObject ; rdfs:range arqo:DepositionEvent ; rdfs:label "wasDepositedBy"@en ; rdfs:comment "Links object to deposition event"@en .
arqo:depositedIntoUnit a owl:ObjectProperty ; rdfs:domain arqo:DepositionEvent ; rdfs:range crmarchaeo:A8_Stratigraphic_Unit ; rdfs:label "depositedIntoUnit"@en ; rdfs:comment "Links deposition to stratigraphic unit"@en .
arqo:wasRecoveredBy a owl:ObjectProperty ; rdfs:domain arqo:ArchaeologicalObject ; rdfs:range arqo:RecoveryEvent ; rdfs:label "wasRecoveredBy"@en ; rdfs:comment "Links object to recovery event"@en .
arqo:recoveryProducedDocumentation a owl:ObjectProperty ; rdfs:domain arqo:RecoveryEvent ; rdfs:range arqo:RecoveryDocumentation ; rdfs:label "recoveryProducedDocumentation"@en ; rdfs:comment "Links recovery to documentation"@en .
arqo:recoveryIncludedObservation a owl:ObjectProperty ; rdfs:domain arqo:RecoveryEvent ; rdfs:range arqo:RecoveryObservation ; rdfs:label "recoveryIncludedObservation"@en ; rdfs:comment "Links recovery to observations"@en .
arqo:recoveryExcavatedFrom a owl:ObjectProperty ; rdfs:domain arqo:RecoveryEvent ; rdfs:range crmarchaeo:A8_Stratigraphic_Unit ; rdfs:label "recoveryExcavatedFrom"@en ; rdfs:comment "Links recovery to source stratigraphic unit"@en .
arqo:hasBiography a owl:ObjectProperty ; rdfs:domain arqo:ArchaeologicalObject ; rdfs:range arqo:ObjectBiography ; rdfs:label "hasBiography"@en ; rdfs:comment "Links object to its biography"@en .
arqo:biographyComprisesEvent a owl:ObjectProperty ; rdfs:domain arqo:ObjectBiography ; rdfs:range crm:E5_Event ; rdfs:label "biographyComprisesEvent"@en ; rdfs:comment "Links biography to constituent events"@en .
arqo:biographicalEventOrder a owl:ObjectProperty , owl:TransitiveProperty ; rdfs:domain crm:E5_Event ; rdfs:range crm:E5_Event ; rdfs:label "biographicalEventOrder"@en ; rdfs:comment "Orders biographical events"@en .
arqo:parallelBiographyOf a owl:ObjectProperty ; rdfs:domain arqo:BiographicalParallelism ; rdfs:range arqo:ObjectBiography ; rdfs:label "parallelBiographyOf"@en ; rdfs:comment "Links parallelism to parallel biographies"@en .
arqo:parallelismSuggests a owl:ObjectProperty ; rdfs:domain arqo:BiographicalParallelism ; rdfs:range crm:E55_Type ; rdfs:label "parallelismSuggests"@en ; rdfs:comment "Cultural practice suggested by parallelism"@en .
arqo:hasInternalClockIndicator a owl:ObjectProperty ; rdfs:domain arqo:ArchaeologicalObject ; rdfs:range arqo:InternalClockIndicator ; rdfs:label "hasInternalClockIndicator"@en ; rdfs:comment "Links object to internal clock indicator"@en .
arqo:indicatorMeasuredBy a owl:ObjectProperty ; rdfs:domain arqo:InternalClockIndicator ; rdfs:range arqo:InternalClockMeasurement ; rdfs:label "indicatorMeasuredBy"@en ; rdfs:comment "Links indicator to its measurement"@en .
arqo:measurementSuggestsTimeSpan a owl:ObjectProperty ; rdfs:domain arqo:InternalClockMeasurement ; rdfs:range crm:E52_Time-Span ; rdfs:label "measurementSuggestsTimeSpan"@en ; rdfs:comment "Links measurement to suggested time-span"@en .
arqo:hasMaterialComponent a owl:ObjectProperty ; rdfs:domain arqo:ArchaeologicalObject ; rdfs:range arqo:MaterialComponent ; rdfs:label "hasMaterialComponent"@en ; rdfs:comment "Links object to material constituent"@en .
arqo:hasMaterialRole a owl:ObjectProperty ; rdfs:domain arqo:MaterialComponent ; rdfs:range crm:E55_Type ; rdfs:label "hasMaterialRole"@en ; rdfs:comment "Role of material component"@en .
arqo:hasMaterialRelation a owl:ObjectProperty ; rdfs:domain arqo:MaterialComponent ; rdfs:range arqo:MaterialRelation ; rdfs:label "hasMaterialRelation"@en ; rdfs:comment "Links component to relational property"@en .
arqo:materialRelationLinksTo a owl:ObjectProperty ; rdfs:domain arqo:MaterialRelation ; rdfs:range arqo:MaterialComponent ; rdfs:label "materialRelationLinksTo"@en ; rdfs:comment "Links relation to second component"@en .
arqo:hasModeOfExperience a owl:ObjectProperty ; rdfs:domain arqo:ArchaeologicalObject ; rdfs:range arqo:ModeOfExperience ; rdfs:label "hasModeOfExperience"@en ; rdfs:comment "Links object to current mode of experience"@en .
arqo:shiftedToMode a owl:ObjectProperty ; rdfs:domain arqo:OntologicalShiftEvent ; rdfs:range arqo:ModeOfExperience ; rdfs:label "shiftedToMode"@en ; rdfs:comment "Links shift to entered mode"@en .
arqo:shiftedFromMode a owl:ObjectProperty ; rdfs:domain arqo:OntologicalShiftEvent ; rdfs:range arqo:ModeOfExperience ; rdfs:label "shiftedFromMode"@en ; rdfs:comment "Links shift to left mode"@en .
arqo:shiftAppliedToObject a owl:ObjectProperty ; rdfs:domain arqo:OntologicalShiftEvent ; rdfs:range arqo:ArchaeologicalObject ; rdfs:label "shiftAppliedToObject"@en ; rdfs:comment "Links shift to affected object"@en .

# --- New in Step 14 (CQ-OBJ-14) ---

arqo:hasRefuseDistributionState a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:RefuseDistributionState ;
    rdfs:label "hasRefuseDistributionState"@en ;
    rdfs:comment "Links an object to its refuse distribution state in the archaeological record (primary, secondary, or de facto refuse)"@en .

arqo:refuseStateEvidencePlace a owl:ObjectProperty ;
    rdfs:domain arqo:RefuseDistributionState ;
    rdfs:range crm:E53_Place ;
    rdfs:label "refuseStateEvidencePlace"@en ;
    rdfs:comment "Links a refuse distribution state to the spatial evidence (place) supporting its classification"@en .

arqo:refuseStateEvidenceVolume a owl:ObjectProperty ;
    rdfs:domain arqo:RefuseDistributionState ;
    rdfs:range crmarchaeo:A2_Stratigraphic_Volume_Unit ;
    rdfs:label "refuseStateEvidenceVolume"@en ;
    rdfs:comment "Links a refuse distribution state to the stratigraphic volume unit providing spatial evidence"@en .


# --- New in Step 15 (CQ-OBJ-15) ---

arqo:hasEmbedding a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:EmbeddingRelation ;
    rdfs:label "hasEmbedding"@en ;
    rdfs:comment "Links an object to its embedding relation within a stratigraphic volume unit"@en .

arqo:embeddingInVolume a owl:ObjectProperty ;
    rdfs:domain arqo:EmbeddingRelation ;
    rdfs:range crmarchaeo:A2_Stratigraphic_Volume_Unit ;
    rdfs:label "embeddingInVolume"@en ;
    rdfs:comment "Links an embedding relation to the stratigraphic volume unit containing the object"@en .

arqo:embeddingContainsObject a owl:ObjectProperty ;
    rdfs:domain arqo:EmbeddingRelation ;
    rdfs:range arqo:ArchaeologicalObject ;
    rdfs:label "embeddingContainsObject"@en ;
    rdfs:comment "Links an embedding relation to the physical object contained within it"@en .


# --- New in Step 16 (CQ-OBJ-16) ---

arqo:hasSurfaceAlteration a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:SurfaceAlteration ;
    rdfs:label "hasSurfaceAlteration"@en ;
    rdfs:comment "Links an object to a surface alteration present on it"@en .

arqo:alterationContributesToPastness a owl:ObjectProperty ;
    rdfs:domain arqo:SurfaceAlteration ;
    rdfs:range arqo:PastnessQuality ;
    rdfs:label "alterationContributesToPastness"@en ;
    rdfs:comment "Links a surface alteration to the pastness quality it helps constitute"@en .

arqo:pastnessAttributedTo a owl:ObjectProperty ;
    rdfs:domain arqo:PastnessQuality ;
    rdfs:range arqo:ArchaeologicalObject ;
    rdfs:label "pastnessAttributedTo"@en ;
    rdfs:comment "Links a pastness quality to the object to which it is attributed"@en .


# --- New in Step 17 (CQ-OBJ-17) ---

arqo:hasFragmentationState a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:FragmentationState ;
    rdfs:label "hasFragmentationState"@en ;
    rdfs:comment "Links an object to its fragmentation state"@en .

arqo:fragmentOf a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:ArchaeologicalObject ;
    rdfs:label "fragmentOf"@en ;
    rdfs:comment "Links a fragment to the original object it is part of (for reassembled or identifiable fragments)"@en .


# --- New in Step 18 (CQ-OBJ-18) ---

arqo:hasMorphometricAttribute a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:MorphometricAttribute ;
    rdfs:label "hasMorphometricAttribute"@en ;
    rdfs:comment "Links an object to one of its morphometric measurements"@en .

arqo:morphometricComparesToType a owl:ObjectProperty ;
    rdfs:domain arqo:MorphometricAttribute ;
    rdfs:range crm:E55_Type ;
    rdfs:label "morphometricComparesToType"@en ;
    rdfs:comment "Links a morphometric measurement to the typological class whose expected range it is compared against"@en .


# --- New in Step 19 (CQ-OBJ-19) ---

arqo:hasComponentPart a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:ComponentPart ;
    rdfs:label "hasComponentPart"@en ;
    rdfs:comment "Links a composite object to one of its physical component parts"@en .

arqo:componentJoinedBy a owl:ObjectProperty ;
    rdfs:domain arqo:ComponentPart ;
    rdfs:range arqo:JoiningTechnique ;
    rdfs:label "componentJoinedBy"@en ;
    rdfs:comment "Links a component part to the joining technique that connects it to the main object"@en .

arqo:componentPartOf a owl:ObjectProperty ;
    owl:inverseOf arqo:hasComponentPart ;
    rdfs:domain arqo:ComponentPart ;
    rdfs:range arqo:ArchaeologicalObject ;
    rdfs:label "componentPartOf"@en ;
    rdfs:comment "Links a component part to the composite object it belongs to"@en .


# --- New in Step 20 (CQ-OBJ-20) ---

arqo:hasVisualAppearance a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:VisualAppearanceAttribute ;
    rdfs:label "hasVisualAppearance"@en ;
    rdfs:comment "Links an object to one of its visual appearance attributes"@en .


# --- New in Step 21 (CQ-OBJ-21) ---

arqo:classifiedUnder a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:TypologicalAssignment ;
    rdfs:label "classifiedUnder"@en ;
    rdfs:comment "Links an object to the typological assignment applied to it"@en .

arqo:assignedToType a owl:ObjectProperty ;
    rdfs:domain arqo:TypologicalAssignment ;
    rdfs:range crm:E55_Type ;
    rdfs:label "assignedToType"@en ;
    rdfs:comment "Links a typological assignment to the type assigned"@en .

arqo:assignmentUsedMethod a owl:ObjectProperty ;
    rdfs:domain arqo:TypologicalAssignment ;
    rdfs:range arqo:ClassificationMethod ;
    rdfs:label "assignmentUsedMethod"@en ;
    rdfs:comment "Links a typological assignment to the classification method employed"@en .


# --- New in Step 22 (CQ-OBJ-22) ---

arqo:hasSignificantFeature a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:SignificantFeature ;
    rdfs:label "hasSignificantFeature"@en ;
    rdfs:comment "Links an object to a diagnostically relevant feature"@en .

arqo:featureSupportsAssignment a owl:ObjectProperty ;
    rdfs:domain arqo:SignificantFeature ;
    rdfs:range arqo:FeatureEvidenceLink ;
    rdfs:label "featureSupportsAssignment"@en ;
    rdfs:comment "Links a significant feature to its evidential link with a chronological or cultural assignment"@en .

arqo:evidenceLinkTargetsPeriod a owl:ObjectProperty ;
    rdfs:domain arqo:FeatureEvidenceLink ;
    rdfs:range crm:E4_Period ;
    rdfs:label "evidenceLinkTargetsPeriod"@en ;
    rdfs:comment "Links an evidence link to the period it supports"@en .


# --- New in Step 23 (CQ-OBJ-23) ---

arqo:hasTypeToPeriodRelationship a owl:ObjectProperty ;
    rdfs:domain arqo:TypologicalAssignment ;
    rdfs:range arqo:TypeToPeriodRelationship ;
    rdfs:label "hasTypeToPeriodRelationship"@en ;
    rdfs:comment "Links a typological assignment to its type-to-period relationship"@en .

arqo:typeToPeriodRelatesType a owl:ObjectProperty ;
    rdfs:domain arqo:TypeToPeriodRelationship ;
    rdfs:range crm:E55_Type ;
    rdfs:label "typeToPeriodRelatesType"@en ;
    rdfs:comment "Links a type-to-period relationship to the typological type"@en .

arqo:typeToPeriodRelatesPeriod a owl:ObjectProperty ;
    rdfs:domain arqo:TypeToPeriodRelationship ;
    rdfs:range crm:E4_Period ;
    rdfs:label "typeToPeriodRelatesPeriod"@en ;
    rdfs:comment "Links a type-to-period relationship to the chronological period"@en .


# --- New in Step 24 (CQ-OBJ-24) ---

arqo:assignedToCompositionalGroup a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:CompositionalGroupAssignment ;
    rdfs:label "assignedToCompositionalGroup"@en ;
    rdfs:comment "Links a metallic object to its compositional group assignment"@en .

arqo:groupAssignmentTargets a owl:ObjectProperty ;
    rdfs:domain arqo:CompositionalGroupAssignment ;
    rdfs:range arqo:CompositionalGroup ;
    rdfs:label "groupAssignmentTargets"@en ;
    rdfs:comment "Links a compositional group assignment to the target compositional group"@en .

arqo:groupAssignmentBasedOn a owl:ObjectProperty ;
    rdfs:domain arqo:CompositionalGroupAssignment ;
    rdfs:range arqo:InternalClockMeasurement ;
    rdfs:label "groupAssignmentBasedOn"@en ;
    rdfs:comment "Links a compositional group assignment to the analytical measurement supporting it"@en .


# --- New in Step 25 (CQ-OBJ-25) ---

arqo:documentedByArchiveRecord a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalObject ;
    rdfs:range arqo:ArchaeologicalArchiveRecord ;
    rdfs:label "documentedByArchiveRecord"@en ;
    rdfs:comment "Links an object to an archive record that documents it"@en .

arqo:archiveRecordHeldBy a owl:ObjectProperty ;
    rdfs:domain arqo:ArchaeologicalArchiveRecord ;
    rdfs:range arqo:ArchiveCollection ;
    rdfs:label "archiveRecordHeldBy"@en ;
    rdfs:comment "Links an archive record to the curated collection holding it"@en .

arqo:archiveRecordDocuments a owl:ObjectProperty ;
    owl:inverseOf arqo:documentedByArchiveRecord ;
    rdfs:domain arqo:ArchaeologicalArchiveRecord ;
    rdfs:range arqo:ArchaeologicalObject ;
    rdfs:label "archiveRecordDocuments"@en ;
    rdfs:comment "Links an archive record to the object it documents"@en .

# ==================== DATA PROPERTIES =====================

arqo:hasProcurementType a owl:DatatypeProperty ; rdfs:domain arqo:ProcurementEvent ; rdfs:range xsd:string ; rdfs:label "hasProcurementType"@en ; rdfs:comment "Type of procurement"@en .
arqo:hasRawMaterialProvenance a owl:DatatypeProperty ; rdfs:domain arqo:ArchaeologicalObject ; rdfs:range xsd:string ; rdfs:label "hasRawMaterialProvenance"@en ; rdfs:comment "Provenance of raw materials"@en .
arqo:hasReuseContext a owl:DatatypeProperty ; rdfs:domain arqo:LateralCyclingEvent ; rdfs:range xsd:string ; rdfs:label "hasReuseContext"@en ; rdfs:comment "Social context of reuse"@en .
arqo:hasDiscardIntentionality a owl:DatatypeProperty ; rdfs:domain arqo:DiscardEvent ; rdfs:range xsd:string ; rdfs:label "hasDiscardIntentionality"@en ; rdfs:comment "Motivation behind discard"@en .
arqo:hasPersonaLabel a owl:DatatypeProperty ; rdfs:domain arqo:SocialPersona ; rdfs:range xsd:string ; rdfs:label "hasPersonaLabel"@en ; rdfs:comment "Label for social persona"@en .
arqo:hasActionSequenceOrder a owl:DatatypeProperty ; rdfs:domain arqo:TechnicalAction ; rdfs:range xsd:nonNegativeInteger ; rdfs:label "hasActionSequenceOrder"@en ; rdfs:comment "Position in chaîne opératoire"@en .
arqo:hasActionDescription a owl:DatatypeProperty ; rdfs:domain arqo:TechnicalAction ; rdfs:range xsd:string ; rdfs:label "hasActionDescription"@en ; rdfs:comment "Description of technical action"@en .
arqo:hasManufacturingTradition a owl:DatatypeProperty ; rdfs:domain arqo:ChaineOperatoire ; rdfs:range xsd:string ; rdfs:label "hasManufacturingTradition"@en ; rdfs:comment "Manufacturing tradition name"@en .
arqo:hasMaintenanceType a owl:DatatypeProperty ; rdfs:domain arqo:MaintenanceEvent ; rdfs:range xsd:string ; rdfs:label "hasMaintenanceType"@en ; rdfs:comment "Type of maintenance"@en .
arqo:hasMaintenanceDescription a owl:DatatypeProperty ; rdfs:domain arqo:MaintenanceEvent ; rdfs:range xsd:string ; rdfs:label "hasMaintenanceDescription"@en ; rdfs:comment "Description of maintenance"@en .
arqo:hasDepositionMotivation a owl:DatatypeProperty ; rdfs:domain arqo:DepositionEvent ; rdfs:range xsd:string ; rdfs:label "hasDepositionMotivation"@en ; rdfs:comment "Motivation behind deposition"@en .
arqo:hasDepositionDate a owl:DatatypeProperty ; rdfs:domain arqo:DepositionEvent ; rdfs:range xsd:string ; rdfs:label "hasDepositionDate"@en ; rdfs:comment "Date of deposition"@en .
arqo:hasRecoveryDate a owl:DatatypeProperty ; rdfs:domain arqo:RecoveryEvent ; rdfs:range xsd:string ; rdfs:label "hasRecoveryDate"@en ; rdfs:comment "Date of recovery"@en .
arqo:hasRecoveryMethod a owl:DatatypeProperty ; rdfs:domain arqo:RecoveryEvent ; rdfs:range xsd:string ; rdfs:label "hasRecoveryMethod"@en ; rdfs:comment "Recovery method employed"@en .
arqo:hasParallelismConfidence a owl:DatatypeProperty ; rdfs:domain arqo:BiographicalParallelism ; rdfs:range xsd:string ; rdfs:label "hasParallelismConfidence"@en ; rdfs:comment "Confidence level of parallelism"@en .
arqo:hasIndicatorType a owl:DatatypeProperty ; rdfs:domain arqo:InternalClockIndicator ; rdfs:range xsd:string ; rdfs:label "hasIndicatorType"@en ; rdfs:comment "Type of internal clock indicator"@en .
arqo:hasMeasuredValue a owl:DatatypeProperty ; rdfs:domain arqo:InternalClockMeasurement ; rdfs:range xsd:decimal ; rdfs:label "hasMeasuredValue"@en ; rdfs:comment "Numeric measured value"@en .
arqo:hasMeasurementUnit a owl:DatatypeProperty ; rdfs:domain arqo:InternalClockMeasurement ; rdfs:range xsd:string ; rdfs:label "hasMeasurementUnit"@en ; rdfs:comment "Unit of measurement"@en .
arqo:hasSuggestedAge a owl:DatatypeProperty ; rdfs:domain arqo:InternalClockMeasurement ; rdfs:range xsd:string ; rdfs:label "hasSuggestedAge"@en ; rdfs:comment "Age suggested by measurement"@en .
arqo:hasMaterialRelationType a owl:DatatypeProperty ; rdfs:domain arqo:MaterialRelation ; rdfs:range xsd:string ; rdfs:label "hasMaterialRelationType"@en ; rdfs:comment "Type of material relation (Knappett)"@en .
arqo:hasMaterialProportion a owl:DatatypeProperty ; rdfs:domain arqo:MaterialComponent ; rdfs:range xsd:decimal ; rdfs:label "hasMaterialProportion"@en ; rdfs:comment "Proportion of material component"@en .

# --- New in Step 14 (CQ-OBJ-14) ---

arqo:hasRefuseType a owl:DatatypeProperty ;
    rdfs:domain arqo:RefuseDistributionState ;
    rdfs:range xsd:string ;
    rdfs:label "hasRefuseType"@en ;
    rdfs:comment "Type of refuse: primary refuse, secondary refuse, or de facto refuse"@en .


# --- New in Step 15 (CQ-OBJ-15) ---

arqo:hasEmbeddingStability a owl:DatatypeProperty ;
    rdfs:domain arqo:EmbeddingRelation ;
    rdfs:range xsd:string ;
    rdfs:label "hasEmbeddingStability"@en ;
    rdfs:comment "Stability of the embedding: stable, disturbed, or redeposited"@en .

arqo:hasEmbeddingNature a owl:DatatypeProperty ;
    rdfs:domain arqo:EmbeddingRelation ;
    rdfs:range xsd:string ;
    rdfs:label "hasEmbeddingNature"@en ;
    rdfs:comment "Physical nature of the embedding: primary context, secondary context, or disturbed context"@en .


# --- New in Step 16 (CQ-OBJ-16) ---

arqo:hasAlterationType a owl:DatatypeProperty ;
    rdfs:domain arqo:SurfaceAlteration ;
    rdfs:range xsd:string ;
    rdfs:label "hasAlterationType"@en ;
    rdfs:comment "Type of surface alteration: patina, corrosion, weathering rind, use-wear polish, oxidation film"@en .

arqo:hasPastnessDegree a owl:DatatypeProperty ;
    rdfs:domain arqo:PastnessQuality ;
    rdfs:range xsd:string ;
    rdfs:label "hasPastnessDegree"@en ;
    rdfs:comment "Degree of perceived pastness: strong, moderate, weak, or artificially enhanced"@en .


# --- New in Step 17 (CQ-OBJ-17) ---

arqo:hasCompletenessPercentage a owl:DatatypeProperty ;
    rdfs:domain arqo:FragmentationState ;
    rdfs:range xsd:decimal ;
    rdfs:label "hasCompletenessPercentage"@en ;
    rdfs:comment "Percentage of the original object that is preserved (0.0 to 100.0)"@en .

arqo:hasFragmentationCategory a owl:DatatypeProperty ;
    rdfs:domain arqo:FragmentationState ;
    rdfs:range xsd:string ;
    rdfs:label "hasFragmentationCategory"@en ;
    rdfs:comment "Category of fragmentation: complete, partially fragmented, isolated sherds"@en .


# --- New in Step 18 (CQ-OBJ-18) ---

arqo:hasMorphometricType a owl:DatatypeProperty ;
    rdfs:domain arqo:MorphometricAttribute ;
    rdfs:range xsd:string ;
    rdfs:label "hasMorphometricType"@en ;
    rdfs:comment "Type of morphometric attribute: length, width, height, weight, volume, surface area, diameter"@en .

arqo:hasMorphometricValue a owl:DatatypeProperty ;
    rdfs:domain arqo:MorphometricAttribute ;
    rdfs:range xsd:decimal ;
    rdfs:label "hasMorphometricValue"@en ;
    rdfs:comment "Numeric value of the morphometric measurement"@en .

arqo:hasMorphometricUnit a owl:DatatypeProperty ;
    rdfs:domain arqo:MorphometricAttribute ;
    rdfs:range xsd:string ;
    rdfs:label "hasMorphometricUnit"@en ;
    rdfs:comment "Unit of measurement for the morphometric attribute (mm, cm, g, kg, ml)"@en .


# --- New in Step 19 (CQ-OBJ-19) ---

arqo:hasComponentRole a owl:DatatypeProperty ;
    rdfs:domain arqo:ComponentPart ;
    rdfs:range xsd:string ;
    rdfs:label "hasComponentRole"@en ;
    rdfs:comment "Functional role of the component: handle, lid, blade, shaft, inlay, attachment, base, rim"@en .

arqo:hasJoiningTechniqueType a owl:DatatypeProperty ;
    rdfs:domain arqo:JoiningTechnique ;
    rdfs:range xsd:string ;
    rdfs:label "hasJoiningTechniqueType"@en ;
    rdfs:comment "Type of joining technique: riveting, soldering, adhesion, mortise-and-tenon, lashing, welding"@en .


# --- New in Step 20 (CQ-OBJ-20) ---

arqo:hasMunsellHue a owl:DatatypeProperty ;
    rdfs:domain arqo:VisualAppearanceAttribute ;
    rdfs:range xsd:string ;
    rdfs:label "hasMunsellHue"@en ;
    rdfs:comment "Munsell hue value (e.g., 5YR, 10R, 2.5Y)"@en .

arqo:hasMunsellValue a owl:DatatypeProperty ;
    rdfs:domain arqo:VisualAppearanceAttribute ;
    rdfs:range xsd:string ;
    rdfs:label "hasMunsellValue"@en ;
    rdfs:comment "Munsell value (lightness/darkness, e.g., 4, 5, 6)"@en .

arqo:hasMunsellChroma a owl:DatatypeProperty ;
    rdfs:domain arqo:VisualAppearanceAttribute ;
    rdfs:range xsd:string ;
    rdfs:label "hasMunsellChroma"@en ;
    rdfs:comment "Munsell chroma (color saturation, e.g., 3, 4, 6)"@en .

arqo:hasSurfaceTexture a owl:DatatypeProperty ;
    rdfs:domain arqo:VisualAppearanceAttribute ;
    rdfs:range xsd:string ;
    rdfs:label "hasSurfaceTexture"@en ;
    rdfs:comment "Surface texture description: smooth, rough, gritty, polished, matte, glossy"@en .

arqo:hasVisualDescription a owl:DatatypeProperty ;
    rdfs:domain arqo:VisualAppearanceAttribute ;
    rdfs:range xsd:string ;
    rdfs:label "hasVisualDescription"@en ;
    rdfs:comment "General visual appearance description"@en .


# --- New in Step 21 (CQ-OBJ-21) ---

arqo:hasClassificationCriteria a owl:DatatypeProperty ;
    rdfs:domain arqo:TypologicalAssignment ;
    rdfs:range xsd:string ;
    rdfs:label "hasClassificationCriteria"@en ;
    rdfs:comment "Criteria defining the assigned type"@en .

arqo:hasMethodType a owl:DatatypeProperty ;
    rdfs:domain arqo:ClassificationMethod ;
    rdfs:range xsd:string ;
    rdfs:label "hasMethodType"@en ;
    rdfs:comment "Type of classification method: monothetic or polythetic"@en .


# --- New in Step 22 (CQ-OBJ-22) ---

arqo:hasEvidenceStrength a owl:DatatypeProperty ;
    rdfs:domain arqo:FeatureEvidenceLink ;
    rdfs:range xsd:string ;
    rdfs:label "hasEvidenceStrength"@en ;
    rdfs:comment "Strength of the evidential link: strong (restricted to), moderate (typical for), weak (appears in)"@en .

arqo:hasFeatureDescription a owl:DatatypeProperty ;
    rdfs:domain arqo:SignificantFeature ;
    rdfs:range xsd:string ;
    rdfs:label "hasFeatureDescription"@en ;
    rdfs:comment "Description of the diagnostically relevant feature"@en .


# --- New in Step 23 (CQ-OBJ-23) ---

arqo:hasTypeToPeriodStrength a owl:DatatypeProperty ;
    rdfs:domain arqo:TypeToPeriodRelationship ;
    rdfs:range xsd:string ;
    rdfs:label "hasTypeToPeriodStrength"@en ;
    rdfs:comment "Strength of the type-to-period relationship: weak (AP29 appears_in), moderate (AP31 typical_for), strong (AP30 restricted_to)"@en .


# --- New in Step 24 (CQ-OBJ-24) ---

arqo:hasAnalyticalTechnique a owl:DatatypeProperty ;
    rdfs:domain arqo:InternalClockMeasurement ;
    rdfs:range xsd:string ;
    rdfs:label "hasAnalyticalTechnique"@en ;
    rdfs:comment "Scientific technique employed: XRF, ICP-MS, SEM-EDS, NAA, etc."@en .

arqo:hasGroupDefiningElements a owl:DatatypeProperty ;
    rdfs:domain arqo:CompositionalGroup ;
    rdfs:range xsd:string ;
    rdfs:label "hasGroupDefiningElements"@en ;
    rdfs:comment "Diagnostic elemental ratios or alloy signatures defining the compositional group"@en .


# --- New in Step 25 (CQ-OBJ-25) ---

arqo:hasArchiveRecordType a owl:DatatypeProperty ;
    rdfs:domain arqo:ArchaeologicalArchiveRecord ;
    rdfs:range xsd:string ;
    rdfs:label "hasArchiveRecordType"@en ;
    rdfs:comment "Type of archive record: field notebook, digital database, photographic archive, drawing collection, published report"@en .

# ===================== RESTRICTIONS =======================

arqo:ProcurementEvent rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty arqo:procurementOccurredAt ; owl:someValuesFrom arqo:RawMaterialSource ] .
arqo:LateralCyclingEvent rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty crm:P12_occurred_in_the_presence_of ; owl:someValuesFrom arqo:ArchaeologicalObject ] .
arqo:RecyclingEvent rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty arqo:recyclingProducedObject ; owl:someValuesFrom arqo:ArchaeologicalObject ] .
arqo:DiscardEvent rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty arqo:discardOccurredAt ; owl:someValuesFrom crm:E53_Place ] .
arqo:SecondaryRefuse rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty arqo:discardMovedTo ; owl:someValuesFrom crm:E53_Place ] .
